                    this.ctx.strokeRect(sc.x - hw, sc.y - hw, sz, sz);
                    this.ctx.fillStyle = col.slice(0, 7) + '22'; this.ctx.fillRect(sc.x - hw, sc.y - hw, sz, sz);
                    this.ctx.restore();

