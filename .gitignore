            }
        }

        if (location.href !== this.lastURL) {
            this.lastURL = location.href; this.targetBlocks = []; this.allBlocks = []; this.camera = null; this.scanState = null;
            if (this.statusEl) this.statusEl.textContent = 'Cargando nueva partida...';
        }

        this.animFrameId = requestAnimationFrame(() => this.renderLoop());
    }

    createUI() {
        if (this.ui) return;

        this.cvs = document.createElement('canvas');
        this.cvs.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:2147483646';
        document.body.appendChild(this.cvs);
        this.ctx = this.cvs.getContext('2d');

        this.resizeHandler = () => {
            if (this.cvs) { this.cvs.width = innerWidth; this.cvs.height = innerHeight; }
        };
        this.resizeHandler();
        window.addEventListener('resize', this.resizeHandler);

        this.ui = document.createElement('div');
        this.ui.style.cssText = 'position:fixed;top:80px;left:80px;width:280px;background:#0d0d0d;color:#e0e0e0;font:11px system-ui,sans-serif;border:1.5px solid #ff1e1e;border-radius:6px;box-shadow:0 0 15px rgba(255,30,30,0.3);z-index:2147483647;user-select:none;display:flex;flex-direction:column;';

        var cbHtml = '';
        for (var i = 0; i < this.ALL_IDS.length; i++) {
            var id = this.ALL_IDS[i], col = this.colorFor(id), name = this.nameFor(id);
            cbHtml += '<label style="display:inline-flex;align-items:center;gap:2px;margin:2px;cursor:pointer;font-size:10px">'
                + '<input type="checkbox" class="bfcb" data-id="' + id + '" checked '
                + 'style="accent-color:' + col + '"> '
                + '<span style="color:' + col + '">' + name + '</span></label>';
        }

        this.ui.innerHTML = '<div class="bfh" style="padding:6px 8px;cursor:move;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ff1e1e;font-weight:700;background:#140505;color:#ff4d4d"><span>Bed Finder</span><button id="bfesp" style="background:#b71c1c;border:1px solid #ff5252;color:#fff;border-radius:3px;padding:2px 7px;cursor:pointer;font-size:10px">ESP ON</button></div>'
            + '<div style="padding:4px 8px;border-bottom:1px solid #260a0a;display:flex;justify-content:space-between;align-items:center;background:#110404;">'
            + '<span style="font-size:10px;color:#888;">Select Beds:</span>'
            + '<div><button id="bfselectall" style="background:#260a0a;border:1px solid #ff3333;color:#ff9999;border-radius:3px;padding:1px 5px;cursor:pointer;font-size:9px;margin-right:3px;">All</button>'
            + '<button id="bfselectnone" style="background:#260a0a;border:1px solid #555;color:#aaa;border-radius:3px;padding:1px 5px;cursor:pointer;font-size:9px;">None</button></div>'
            + '</div>'
            + '<div style="padding:4px 8px;border-bottom:1px solid #260a0a">' + cbHtml + '</div>'
            + '<div style="padding:4px 8px;border-bottom:1px solid #260a0a;display:flex;gap:4px;align-items:center;flex-wrap:wrap;">'
            + '<label style="font-size:10px;color:#ccc">R:<input id="bfr" type="number" min="1" max="' + this.MAX_RADIUS + '" value="' + this.SEARCH_RADIUS + '" style="width:26px;background:#1a1a1a;border:1px solid #ff1e1e;color:#fff;border-radius:3px;padding:2px 2px;text-align:center"></label>'
            + '<label style="font-size:10px;color:#ccc">FOV:<input id="bffov" type="number" value="' + this.FOV_Y + '" style="width:30px;background:#1a1a1a;border:1px solid #ff1e1e;color:#fff;border-radius:3px;padding:2px 2px;text-align:center"></label>'
            + '<label style="font-size:10px;color:#ccc">Max:<input id="bfmax" type="number" min="1" max="20" value="' + this.BATCH_SIZE + '" style="width:26px;background:#1a1a1a;border:1px solid #ff1e1e;color:#fff;border-radius:3px;padding:2px 2px;text-align:center"></label>'
            + '<button id="bfscan" style="background:#81c784;border:none;color:#000;font-weight:bold;border-radius:3px;padding:2px 6px;cursor:pointer;font-size:10px;margin-left:auto;">Scan</button>'
            + '</div>'
            + '<div id="bfst" style="padding:2px 8px;font-size:10px;color:#ff6666;border-bottom:1px solid #260a0a">Esperando partida...</div>'
            + '<div id="bflist" style="max-height:180px;overflow:auto;padding:4px 8px 8px;font-family:monospace;white-space:pre;font-size:11px;color:#ffb3b3"></div>'
            + '<div class="bfb-drag" style="padding:6px;cursor:move;background:#140505;border-top:1px solid #ff1e1e;display:flex;justify-content:center;align-items:center;border-radius:0 0 4px 4px;">'
            + '<div style="width:40px;height:4px;background:#ff4d4d;border-radius:2px;box-shadow:0 0 5px rgba(255,77,77,0.5);"></div>'
            + '</div>';

        document.body.appendChild(this.ui);
        this.listEl = this.ui.querySelector('#bflist');
        this.statusEl = this.ui.querySelector('#bfst');

        const readActive = () => {
            this.ACTIVE_IDS = [];
            var cbs = this.ui.querySelectorAll('.bfcb');
            for (var i = 0; i < cbs.length; i++) if (cbs[i].checked) this.ACTIVE_IDS.push(parseInt(cbs[i].dataset.id));
        };

        this.ui.querySelectorAll('.bfcb').forEach(cb => {
            cb.addEventListener('change', () => { readActive(); this.forceScan(); });
        });

        this.ui.querySelector('#bfselectall').onclick = () => {
            this.ui.querySelectorAll('.bfcb').forEach(cb => cb.checked = true);
            readActive();
            this.forceScan();
        };

        this.ui.querySelector('#bfselectnone').onclick = () => {
            this.ui.querySelectorAll('.bfcb').forEach(cb => cb.checked = false);
            readActive();
            this.forceScan();
        };

        this.ui.querySelector('#bfscan').onclick = () => {
            this.SEARCH_RADIUS = this.clampR(this.ui.querySelector('#bfr').value);
            this.ui.querySelector('#bfr').value = this.SEARCH_RADIUS;
            this.FOV_Y = parseInt(this.ui.querySelector('#bffov').value) || 70;
            this.BATCH_SIZE = Math.max(1, Math.min(20, parseInt(this.ui.querySelector('#bfmax').value) || 10));
            this.ui.querySelector('#bfmax').value = this.BATCH_SIZE;
            readActive(); this.forceScan();
        };

        this.ui.querySelector('#bfr').addEventListener('change', (e) => {
            this.SEARCH_RADIUS = this.clampR(e.target.value);
            e.target.value = this.SEARCH_RADIUS;
        });

        this.ui.querySelector('#bffov').addEventListener('change', (e) => {
            this.FOV_Y = parseInt(e.target.value) || 70;
        });

        this.ui.querySelector('#bfmax').addEventListener('change', (e) => {
            this.BATCH_SIZE = Math.max(1, Math.min(20, parseInt(e.target.value) || 10));
            e.target.value = this.BATCH_SIZE;
            this.forceScan();
        });

        this.ui.querySelector('#bfesp').onclick = (e) => {
            this.espOn = !this.espOn;
            e.target.textContent = this.espOn ? 'ESP ON' : 'ESP OFF';
            e.target.style.background = this.espOn ? '#b71c1c' : '#333';
            e.target.style.borderColor = this.espOn ? '#ff5252' : '#555';
        };

        var drag = false, ox = 0, oy = 0;

        const startDrag = (clientX, clientY) => {
            drag = true;
            ox = clientX - this.ui.offsetLeft;
            oy = clientY - this.ui.offsetTop;
        };

        const doDrag = (clientX, clientY) => {
            if (drag) {
                this.ui.style.left = (clientX - ox) + 'px';
                this.ui.style.top = (clientY - oy) + 'px';
            }
        };

        const stopDrag = () => { drag = false; };

        var dragElements = [this.ui.querySelector('.bfh'), this.ui.querySelector('.bfb-drag')];
        dragElements.forEach(el => {
            el.addEventListener('mousedown', (e) => startDrag(e.clientX, e.clientY));
            el.addEventListener('touchstart', (e) => {
                if (e.touches.length === 1) startDrag(e.touches[0].clientX, e.touches[0].clientY);
            }, { passive: true });
        });

        document.addEventListener('mousemove', (e) => doDrag(e.clientX, e.clientY));
        document.addEventListener('mouseup', stopDrag);

        document.addEventListener('touchmove', (e) => {
            if (drag && e.touches.length === 1) doDrag(e.clientX, e.clientY);
        }, { passive: true });
        document.addEventListener('touchend', stopDrag);
    }

    destroyUI() {
        if (this.cvs) {
            this.cvs.remove();
            this.cvs = null;
            this.ctx = null;
        }
        if (this.ui) {
            this.ui.remove();
            this.ui = null;
        }
        if (this.resizeHandler) {
            window.removeEventListener('resize', this.resizeHandler);
            this.resizeHandler = null;
        }
    }

    onEnable() {
        this.createUI();
        var o = this.getO();
        if (o) {
            this.findCamera(o);
            this.startScan(o);
        }
        this.renderLoop();
    }

    onDisable() {
        if (this.animFrameId) {
            cancelAnimationFrame(this.animFrameId);
            this.animFrameId = null;
        }
        this.destroyUI();
        this.targetBlocks = [];
        this.allBlocks = [];
        this.camera = null;
        this.scanState = null;
    }

    onSettingsChange() {}
};
    var ModAirPlace = class extends a { constructor() { super("AirPlace", "Misc"); } get blockPlaceSystem() { return o.gameWorld.systemsManager.activeSystems.find(e => e?._handlePlaceInAir); } onRender() { if (this.blockPlaceSystem) this.blockPlaceSystem.canPlaceBlocksInAir = true; } onDisable() { if (this.blockPlaceSystem && (!h.modules.Scaffold || !h.modules.Scaffold.isEnabled)) { this.blockPlaceSystem.canPlaceBlocksInAir = o.gameWorld.player.gameMode == 2; } } };

    // ================== MENUS MODULES ==================
    var ModCrafting = class extends a { constructor() { super("Crafting", "Menuspatch:("); } onEnable() { m.openOtherItem(2); this.disable(); if (h.modules.ClickGUI) h.modules.ClickGUI.onDisable(false); } };
    var ModDyeingTable = class extends a { constructor() { super("DyeingTable", "Menuspatch:("); } onEnable() { m.openOtherItem(9); this.disable(); if (h.modules.ClickGUI) h.modules.ClickGUI.onDisable(false); } };
    var ModCuttingTable = class extends a { constructor() { super("CuttingTable", "Menuspatch:("); } onEnable() { m.openOtherItem(10); this.disable(); if (h.modules.ClickGUI) h.modules.ClickGUI.onDisable(false); } };

    // 🌐 WORLD MODULES
    var ModAntiBan = class extends a {
        constructor() {
            super("AntiBanpatch:(", "World", {
                "Auto Disable Combat": true,
                "Tab Blur Protection": true,
                "Console Cloak": true,
                "Smooth Rotations": true,
                "Randomize Delays": true,
                "Jitter MS (±)": 25,
                "Staff Detection": true,
                "Auto Hide GUI": true
            });
            this._staffKeywords = ["admin","mod","staff","helper","support","gm","owner","dev","operator","op","trial","spectator","watch"];
            this._suspectPlayers = [];
            this._lastScan = 0;
            this._ogConsole = {};
            this._blurred = false;
            this._scanInterval = null;
            this._consoleCleanInterval = null;
            this._moduleTimers = {};
            this._onBlur = () => { this._blurred = true; if(this.options["Tab Blur Protection"] && this.isEnabled) this.handleBlur(); };
            this._onFocus = () => { this._blurred = false; if(this.options["Tab Blur Protection"] && this.isEnabled) this.handleFocus(); };
        }
        onEnable() {
            if (this.options["Staff Detection"]) {
                this._scanInterval = setInterval(() => this.scanForStaff(), 3000);
                this.scanForStaff();
            }
            if (this.options["Console Cloak"]) {
                this._ogConsole = { log: console.log, warn: console.warn, error: console.error, info: console.info };
                const self = this;
                const filter = (args) => { const str = Array.from(args).join(' ').toLowerCase(); return str.includes('neonviper') || str.includes('tvclient') || str.includes('hack') || str.includes('cheat') || str.includes('module') || str.includes('killaura') || str.includes('aimbot'); };
                console.log = function() { if (!filter(arguments)) self._ogConsole.log.apply(console, arguments); };
                console.warn = function() { if (!filter(arguments)) self._ogConsole.warn.apply(console, arguments); };
                console.error = function() { if (!filter(arguments)) self._ogConsole.error.apply(console, arguments); };
                console.info = function() { if (!filter(arguments)) self._ogConsole.info.apply(console, arguments); };
                this._consoleCleanInterval = setInterval(() => { try { console.clear(); } catch(e) {} }, 30000);
            }
            if (this.options["Tab Blur Protection"]) { window.addEventListener("blur", this._onBlur); window.addEventListener("focus", this._onFocus); }
            if (this.options["Randomize Delays"]) {
                const killaura = h.modules["Killaura"];
                if (killaura && killaura.options && killaura.options["Delay"]) {
                    this._moduleTimers.killaura = killaura.options["Delay"];
                    const jitter = parseInt(this.options["Jitter MS (±)"]) || 25;
                    Object.defineProperty(killaura.options, "Delay", {
                        get: () => { const base = this._moduleTimers.killaura; return base + Math.floor(Math.random() * jitter * 2 - jitter); },
                        set: (val) => { this._moduleTimers.killaura = val; },
                        configurable: true
                    });
                }
            }
            if (this.options["Smooth Rotations"]) {
                const aimbot = h.modules["Aimbot"];
                if (aimbot && aimbot.aimAtEnemy) {
                    const smoothFactor = 0.35 + Math.random() * 0.3;
                    aimbot.aimAtEnemy = function() {
                        const e = o.gameWorld.player, t = o.gameWorld.server.players;
                        if (!e || !t) return;
                        const i = aimbot.getClosestEnemy(e, t);
                        if (i) {
                            const s = i.model.position, n = e.position;
                            const l = { x: s.x - n.x, z: s.z - n.z };
                            const d = Math.atan2(l.x, l.z);
                            const u = parseFloat(aimbot.options["Y Offset"] || "-0.7");
                            const y = s.y + u - n.y;
                            const f = Math.hypot(l.x, l.z);
                            let g = Math.atan2(y, f);
                            g = Math.max(Math.min(g, Math.PI / 2), -Math.PI / 2);
                            let b = (d + Math.PI) % (2 * Math.PI);
                            if (window._lastAimYaw !== undefined) { let yawDiff = b - window._lastAimYaw; if (yawDiff > Math.PI) yawDiff -= 2 * Math.PI; if (yawDiff < -Math.PI) yawDiff += 2 * Math.PI; b = window._lastAimYaw + yawDiff * smoothFactor; }
                            if (window._lastAimPitch !== undefined) { g = window._lastAimPitch + (g - window._lastAimPitch) * smoothFactor; }
                            window._lastAimYaw = b; window._lastAimPitch = g;
                            e.rotation.y = b; e.rotation.x = g;
                        }
                    };
                }
            }
            showNotification("🛡️ AntiBan active", true);
        }
        scanForStaff() {
            this._lastScan = Date.now();
            if (!o?.gameWorld?.server?.players) return;
            const players = o.gameWorld.server.players;
            players.forEach((p, id) => {
                if (!p || !p.name) return;
                const name = p.name.toLowerCase();
                const isStaff = this._staffKeywords.some(kw => name.includes(kw) || name.replace(/[^a-z0-9]/g, '').includes(kw));
                if (isStaff && !this._suspectPlayers.includes(id)) {
                    this._suspectPlayers.push(id);
                    showNotification(`⚠️ Staff detected: ${p.name}`, false, true);
                    if (this.options["Auto Disable Combat"]) this.disableCombatModules();
                    if (this.options["Auto Hide GUI"]) this.hideGUI();
                }
            });
        }
        handleBlur() { if (this._blurred) { this.disableCombatModules(); showNotification("⚠️ Tab blurred - modules disabled", false, true); } }
        handleFocus() { showNotification("✅ Tab focused - re-enable manually", true); }
        disableCombatModules() { ["Killaura","Aimbot","Rangeclick beta","GunModifier","Fly","Speed","NoClip","Timer"].forEach(name => { const mod = h.modules[name]; if(mod && mod.isEnabled) try{mod.disable()}catch(e){} }); }
        hideGUI() { const clickGUI = h.modules["ClickGUI"]; if(clickGUI && clickGUI.isEnabled) try{clickGUI.onDisable(false)}catch(e){} }
        onDisable() {
            if(this._ogConsole.log){console.log=this._ogConsole.log;console.warn=this._ogConsole.warn;console.error=this._ogConsole.error;console.info=this._ogConsole.info;this._ogConsole={}}
            if(this._scanInterval)clearInterval(this._scanInterval);
            if(this._consoleCleanInterval)clearInterval(this._consoleCleanInterval);
            window.removeEventListener("blur",this._onBlur);window.removeEventListener("focus",this._onFocus);
            if(this._moduleTimers.killaura){const k=h.modules["Killaura"];if(k&&k.options){delete k.options.Delay;k.options.Delay=this._moduleTimers.killaura}}
            this._suspectPlayers=[];this._blurred=false;window._lastAimYaw=undefined;window._lastAimPitch=undefined;
        }
    };
    var ModFastBreak = class extends a {
    constructor() {
        super("Fast Break", "World");
        this.desc = "Breaks blocks faster: holding LMB keeps breaking (chain), 100% speed = instant break (Instabreak).";

        this.set = { speed: 80 };
        this.settings = [
            { type: 'slider', id: 'speed', label: 'Speed', min: 0, max: 100, step: 1 }
        ];

        // Constants
        this.TICK_MS = 50;
        this.SCAN_MS = 1000;
        this.SWING_MIN_MS = 200;
        this.GHOST_GUARD_MS = 12;
        this.SWING_EVENT = 409;

        // Internal State
        this.timer = 0;
        this.system = null;
        this.sysOrig = null;
        this.patchedIV = false;
        this.patchedMS = false;
        this.logged = false;
        this.emitHost = null;
        this.emitOrig = null;
        this.emitBound = null;
        this.lastSwingAt = 0;
    }

    log(msg) {
        console.log('[Fast Break] ' + msg);
    }

    getCtx() {
        try {
            const appEl = document.getElementById('app');
            const app = appEl && appEl.__vue_app__;
            const pinia = app && app.config && app.config.globalProperties && app.config.globalProperties.$pinia;
            if (!pinia || !pinia._s) return null;
            const gs = pinia._s.get('gameState');
            const gw = gs && gs.gameWorld;
            if (!gw || !gw.systemsManager || !gw.player) return null;
            return { gs: gs, gw: gw };
        } catch (err) {
            return null;
        }
    }

    getSystem(gw) {
        try {
            const sm = gw.systemsManager;
            if (!sm || !sm.activeSystems) return null;
            const arr = sm.activeSystems;
            for (let i = 0; i < arr.length; i++) {
                const s = arr[i];
                if (s && s.gameWorld === gw &&
                    s.blockDestruction && typeof s.blockDestruction.key === 'string' &&
                    typeof s.blockDestruction.state === 'number' &&
                    typeof s._handleProgressiveBlockBreaking === 'function' &&
                    typeof s.placeBlockOnIntersect === 'function' &&
                    typeof s.blockBreakingIntervalMs === 'number') {
                    return s;
                }
            }
        } catch (err) {}
        return null;
    }

    getFactor() {
        let sp = Number(this.set.speed);
        if (!isFinite(sp)) sp = 80;
        if (sp <= 0) return 0;
        if (sp <= 1) return 1;
        if (sp < 10) return 1 + (sp - 1) / 9 * 0.5;
        return Math.min(20, 1.3055555555555556 + sp * 0.0008333333333333333 + sp * sp * 0.0018611111111111111);
    }

    getToolStrength(sys) {
        try {
            const gw = sys.gameWorld;
            const pid = gw.player && gw.player.currentInventoryItemId;
            if (pid === undefined || pid === null) return null;
            const tools = gw.structuredItems && gw.structuredItems.tools;
            const u = tools && tools[pid];
            const u2 = u || (gw.items && gw.items[pid]);
            if (!u2 || typeof u2.strength !== 'number' || !isFinite(u2.strength)) return null;
            const s = u2.strength;
            if (!(s > 1)) return null;
            let mat;
            try {
                const bxyz = gw.player && gw.player.destroyingBlockXYZ;
                if (bxyz && gw.chunkManager && typeof gw.chunkManager.getBlock === 'function') {
                    const bid = gw.chunkManager.getBlock(bxyz[0], bxyz[1], bxyz[2]);
                    const blk = gw.chunkManager.blocks && gw.chunkManager.blocks[bid];
                    mat = blk && blk.destruction && blk.destruction.material;
                }
            } catch (err2) {}
            if (u && Array.isArray(u.materials) && u.materials.indexOf(mat) >= 0) return null;
            return s;
        } catch (err3) {
            return null;
        }
    }

    getDelayMs() {
        let sp = Number(this.set.speed);
        if (!isFinite(sp)) sp = 80;
        return this.TICK_MS + (sp >= 100 ? this.GHOST_GUARD_MS : 0);
    }

    hookEmitter(gw) {
        if (!gw || !gw.eventEmitter) return;
        const em = gw.eventEmitter;
        if (em.emit === this.emitProxy) return;

        this.emitOrig = em.emit;
        this.emitBound = em.emit.bind(em);
        this.emitHost = em;

        const self = this;
        this.emitProxy = function(type) {
            if (type === self.SWING_EVENT) {
                const now = Date.now();
                if (now - self.lastSwingAt < self.SWING_MIN_MS) return undefined;
                self.lastSwingAt = now;
            }
            return self.emitBound.apply(null, arguments);
        };

        em.emit = this.emitProxy;
    }

    unhookEmitter() {
        if (this.emitHost && this.emitHost.emit === this.emitProxy) {
            this.emitHost.emit = this.emitOrig;
        }
        this.emitHost = null;
        this.emitOrig = null;
        this.emitBound = null;
        this.emitProxy = null;
    }

    unpatch() {
        this.unhookEmitter();
        if (!this.system) return;
        if (this.patchedIV) {
            try { delete this.system.blockBreakingIntervalMs; } catch (err) {}
        }
        if (this.patchedMS) {
            try { delete this.system.miningSpeedMultiplier; } catch (err) {}
        }
        this.system = null;
        this.sysOrig = null;
        this.patchedIV = false;
        this.patchedMS = false;
    }

    patch(sys) {
        if (this.system === sys) return;
        this.unpatch();
        let ivNative = 210;
        let msDesc = null;
        let msNative = 1;
        try {
            const proto = Object.getPrototypeOf(sys);
            const ivDesc = Object.getOwnPropertyDescriptor(proto, 'blockBreakingIntervalMs');
            if (ivDesc && typeof ivDesc.get === 'function') ivNative = ivDesc.get.call(sys);
            msDesc = Object.getOwnPropertyDescriptor(proto, 'miningSpeedMultiplier');
            if (msDesc && typeof msDesc.get === 'function') msNative = msDesc.get.call(sys);
        } catch (err) {}

        this.sysOrig = { ivNative: ivNative, msNative: msNative, msDesc: msDesc };
        const self = this;

        try {
            Object.defineProperty(sys, 'blockBreakingIntervalMs', {
                configurable: true,
                get: function () {
                    try {
                        return self.getDelayMs();
                    } catch (err) {
                        return self.sysOrig ? self.sysOrig.ivNative : 210;
                    }
                }
            });
