    injectTVClientStyles() {
        if (document.getElementById("tvclient-clickgui-style")) return;
        const style = document.createElement("style");
        style.id = "tvclient-clickgui-style";
        style.textContent = `
            @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&family=Rajdhani:wght@600;700&display=swap');

            :root {
                --TVClient-accent-color: linear-gradient(135deg, #ff0000 0%, #cc0000 100%);
                --button-color: rgba(12, 10, 15, 0.85);
                --hover-color: rgba(80, 0, 0, 0.9);
                --header-bg: rgba(25, 3, 3, 0.98);
                --panel-bg: rgba(10, 8, 12, 0.92);
                --text-color: #ff0000;
            }

            .gui-panel {
                background: var(--panel-bg) !important;
                border: 1px solid rgba(255, 0, 0, 0.7) !important;
                border-radius: 6px !important;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.85), 0 0 15px rgba(255, 0, 0, 0.4) !important;
                backdrop-filter: blur(16px) saturate(180%) !important;
                overflow: hidden !important;
                font-family: 'Rajdhani', sans-serif !important;
                position: fixed !important;
                z-index: 999999 !important;
                touch-action: none !important;
                user-select: none !important;
                width: 190px !important;
            }

            .gui-panel-header {
                background: var(--header-bg) !important;
                border-bottom: 1px solid rgba(255, 0, 0, 0.8) !important;
                color: #ff0000 !important;
                font-family: 'Orbitron', sans-serif !important;
                font-weight: 800 !important;
                font-size: 11px !important;
                letter-spacing: 1.5px !important;
                text-transform: uppercase !important;
                padding: 8px 10px !important;
                position: relative !important;
                cursor: grab !important;
                display: flex !important;
                align-items: center !important;
                justify-content: space-between !important;
            }

            .gui-panel-header:active {
                cursor: grabbing !important;
            }

            .gui-panel-header span,
            .gui-panel-header i,
            .gui-panel-header svg {
                color: var(--text-color) !important;
                text-shadow: 0 0 8px rgba(255, 0, 0, 0.9) !important;
            }

            .gui-panel-content {
                max-height: 380px !important;
                overflow-y: auto !important;
                padding: 4px !important;
                scrollbar-width: thin !important;
                scrollbar-color: #ff0000 rgba(0,0,0,0.3) !important;
            }

            .gui-panel-content::-webkit-scrollbar {
                width: 3px !important;
            }
            .gui-panel-content::-webkit-scrollbar-thumb {
                background: #ff0000 !important;
                border-radius: 3px !important;
            }

            .gui-button {
                background: var(--button-color) !important;
                color: #cccccc !important;
                font-family: 'Rajdhani', sans-serif !important;
                font-size: 13px !important;
                font-weight: 600 !important;
                letter-spacing: 0.5px !important;
                border: 1px solid rgba(255, 255, 255, 0.03) !important;
                border-left: 2px solid transparent !important;
                transition: all 0.15s ease-in-out !important;
                margin: 2px 0 !important;
                padding: 6px 8px !important;
                border-radius: 4px !important;
                position: relative !important;
                cursor: pointer !important;
            }

            .gui-button:hover {
                background: var(--hover-color) !important;
                color: #ff0000 !important;
                border-left-color: #ff0000 !important;
                padding-left: 12px !important;
                box-shadow: -2px 0 8px rgba(255, 0, 0, 0.5) !important;
            }

            .gui-button.enabled {
                background: linear-gradient(90deg, rgba(255, 0, 0, 0.55) 0%, rgba(25, 3, 3, 0.85) 100%) !important;
                color: #ff0000 !important;
                font-weight: 700 !important;
                border-left: 3px solid #ff0000 !important;
                box-shadow: inset 0 0 8px rgba(255, 0, 0, 0.6) !important;
                text-shadow: 0 0 6px rgba(255, 0, 0, 0.95) !important;
            }

            .gui-background {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: 100vw !important;
                height: 100vh !important;
                z-index: 999990 !important;
                background: radial-gradient(circle, rgba(40, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.85) 100%) !important;
                backdrop-filter: blur(6px) !important;
            }

            #tvclient-toggle-btn {
                position: fixed;
                top: 15px;
                left: 15px;
                z-index: 9999999;
                background: rgba(15, 3, 8, 0.85);
                border: 1.5px solid #ff0000;
                color: #ff0000;
                font-family: 'Orbitron', sans-serif;
                font-weight: 800;
                font-size: 11px;
                padding: 8px 14px;
                border-radius: 20px;
                cursor: move;
                box-shadow: 0 0 12px rgba(255, 0, 0, 0.5);
                backdrop-filter: blur(8px);
                transition: transform 0.1s ease, background 0.2s ease, color 0.2s ease;
                user-select: none;
                touch-action: none;
            }

            #tvclient-toggle-btn:hover {
                background: #ff0000;
                color: #ff0000;
                box-shadow: 0 0 18px rgba(255, 0, 0, 0.9);
            }
        `;
        document.head.appendChild(style);
    }

    createToggleButton() {
        if (document.getElementById("tvclient-toggle-btn")) return;
        this.toggleBtn = document.createElement("button");
        this.toggleBtn.id = "tvclient-toggle-btn";
        this.toggleBtn.textContent = "✋📺🤚";
        document.body.appendChild(this.toggleBtn);

        let isDragging = false;
        let hasDragged = false;
        let startX, startY, initialLeft, initialTop;

        const onStart = (e) => {
            isDragging = true;
            hasDragged = false;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            startX = clientX;
            startY = clientY;
            initialLeft = this.toggleBtn.offsetLeft;
            initialTop = this.toggleBtn.offsetTop;
        };

        const onMove = (e) => {
            if (!isDragging) return;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            const dx = clientX - startX;
            const dy = clientY - startY;

            if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
                hasDragged = true;
            }

            this.toggleBtn.style.left = `${initialLeft + dx}px`;
            this.toggleBtn.style.top = `${initialTop + dy}px`;
        };

        const onEnd = (e) => {
            if (!isDragging) return;
            isDragging = false;
            if (!hasDragged) {
                this.toggle();
            }
        };

        this.toggleBtn.addEventListener("mousedown", onStart);
        this.toggleBtn.addEventListener("touchstart", onStart, { passive: true });
        window.addEventListener("mousemove", onMove);
        window.addEventListener("touchmove", onMove, { passive: true });
        window.addEventListener("mouseup", onEnd);
        window.addEventListener("touchend", onEnd);
    }

    updateAnimations() {
        if (this.options["Enable Animations"]) document.body.classList.add("with-animations");
        else document.body.classList.remove("with-animations");
    }

    updateColors() {
        document.body.style.setProperty("--TVClient-accent-color", `linear-gradient(135deg, ${this.options["Accent Color 1"]} 0%, ${this.options["Accent Color 2"]} 100%)`);
        document.body.style.setProperty("--button-color", this.options["Button Color"]);
        document.body.style.setProperty("--hover-color", this.options["Hover Color"]);
        document.body.style.setProperty("--header-bg", this.options["Header Color"]);
        document.body.style.setProperty("--panel-bg", this.options["Panel Color"]);
        document.body.style.setProperty("--text-color", this.options["Text Color"]);
    }

    makeDraggable(panelEl, headerEl) {
        let isDragging = false, startX, startY, initialLeft, initialTop;

        const onStart = (e) => {
            isDragging = true;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            startX = clientX;
            startY = clientY;
            initialLeft = panelEl.offsetLeft;
            initialTop = panelEl.offsetTop;
        };

        const onMove = (e) => {
            if (!isDragging) return;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            panelEl.style.left = `${initialLeft + (clientX - startX)}px`;
            panelEl.style.top = `${initialTop + (clientY - startY)}px`;
        };

        const onEnd = () => { isDragging = false; };

        headerEl.addEventListener("mousedown", onStart);
        headerEl.addEventListener("touchstart", onStart, { passive: true });
        window.addEventListener("mousemove", onMove);
        window.addEventListener("touchmove", onMove, { passive: true });
        window.addEventListener("mouseup", onEnd);
        window.addEventListener("touchend", onEnd);
    }

    onEnable() {
        if (document.pointerLockElement) document.exitPointerLock();
        if (this.GUILoaded) {
            this.showGUI();
            this.updateAnimations();
        } else {
            this.setupBackground();
            this.createPanels();
            this.setupEventListeners();
            this.GUILoaded = true;
            this.updateAnimations();
            this.showGUI();
        }
        let e = typeof m !== "undefined" && m.getCssRule ? m.getCssRule(".pause-cont") : null;
        if (e) e.style.display = "none";
        this.fixCanvas();
    }

    fixCanvas() {
        let gameEl = document.querySelector("#game");
        if (gameEl) gameEl.dispatchEvent(new Event("resize", { bubbles: true }));
    }

    setupBackground() {
        if (!this.blurredBackground) {
            this.blurredBackground = document.createElement("div");
            this.blurredBackground.className = "gui-background";
            this.blurredBackground.onclick = () => this.toggle();
            document.body.appendChild(this.blurredBackground);
        }
    }

    createPanels() {
        let categories = [
            { title: "Combat", position: { top: "60px", left: "20px" } },
            { title: "Movement", position: { top: "60px", left: "220px" } },
            { title: "Visual", position: { top: "60px", left: "420px" } },
            { title: "Misc", position: { top: "60px", left: "620px" } },
            { title: "Menuspatch:(", position: { top: "60px", left: "820px" } },
            { title: "Fun", position: { top: "60px", left: "1020px" } },
            { title: "World", position: { top: "60px", left: "1220px" } }
        ];

        this.panels.forEach(p => {
            let el = p.panel || p.element || p.container;
            if (el && el.parentNode) el.parentNode.removeChild(el);
        });
        this.panels = [];

        categories.forEach(cat => {
            let panelInstance = new S(cat.title, cat.position);
            this.panels.push(panelInstance);

            setTimeout(() => {
                let el = panelInstance.panel || panelInstance.element || panelInstance.container || panelInstance.mainElement;
                if (el) {
                    let header = el.querySelector(".gui-panel-header") || el;
                    this.makeDraggable(el, header);
                }
            }, 50);
        });

        let modulesByCat = {};
        if (typeof h !== "undefined" && h.modules) {
            Object.values(h.modules).forEach(mod => {
                if (!modulesByCat[mod.category]) modulesByCat[mod.category] = [];
                modulesByCat[mod.category].push(mod);
            });
        }

        Object.entries(modulesByCat).forEach(([catName, mods]) => {
            let panel = this.panels.find(p => p.categoryName === catName);
            if (panel) {
                mods.sort((a, b) => b.name.length - a.name.length);
                mods.forEach(mod => panel.addButton(mod));
            }
        });
    }

    setupEventListeners() {
        if (typeof c !== "undefined" && c.on) {
            c.on("module.update", (module) => {
                let panel = this.panels.find(p => p.categoryName === module.category);
                if (!panel) return;
                let btn = panel.buttons ? panel.buttons.find(b => b.textContent === module.name) : null;
                if (btn) btn.classList.toggle("enabled", module.isEnabled);
            });
        }
    }

    showGUI() {
        this.panels.forEach(p => {
            if (typeof p.show === "function") p.show();
            let el = p.panel || p.element || p.container || p.mainElement;
            if (el) {
                el.style.setProperty("display", "block", "important");
                el.style.setProperty("visibility", "visible", "important");
            }
        });
        if (this.blurredBackground) this.blurredBackground.style.setProperty("display", "block", "important");
    }

    onDisable(keepClick = true) {
        this.panels.forEach(p => {
            if (typeof p.hide === "function") p.hide();
            let el = p.panel || p.element || p.container || p.mainElement;
            if (el) {
                el.style.setProperty("display", "none", "important");
                el.style.setProperty("visibility", "hidden", "important");
            }
        });

        document.querySelectorAll(".gui-panel").forEach(el => {
            el.style.setProperty("display", "none", "important");
            el.style.setProperty("visibility", "hidden", "important");
        });

        if (this.blurredBackground) this.blurredBackground.style.setProperty("display", "none", "important");

        let e = typeof m !== "undefined" && m.getCssRule ? m.getCssRule(".pause-cont") : null;
        if (e) e.style.display = "";
        let i = document.getElementsByClassName("pause-cont")[0];
        if (i) i.style.display = "none";
        this.fixCanvas();
        let s = document.querySelector("#game");
        if (keepClick && s) s.click();
    }

    onSettingUpdate() {
        this.updateColors();
        this.updateAnimations();
    }
};
