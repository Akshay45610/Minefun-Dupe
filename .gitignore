    var Modicewalk = class extends a {
    constructor() {
        super("Ice Walk", "Movement");
        this.desc = "Removes slippery movement on ice.";
        this.set = {};
        this.settings = null;

        this.IW_SCAN_MS = 1000;
        this.iwSys = null;
        this.iwOrigExec = null;
        this.iwTimer = 0;
        this.iwLogged = false;
    }

    log(msg) {
        console.log('[Ice Walk] ' + msg);
    }

    getCtx() {
        try {
            const appEl = document.getElementById('app');
            const app = appEl && appEl.__vue_app__;
            const pinia = app && app.config && app.config.globalProperties && app.config.globalProperties.$pinia;
            if (!pinia || !pinia._s) return null;
            const gs = pinia._s.get('gameState');
            const gw = gs && gs.gameWorld;
            if (!gs || !gw || !gw.player || !gw.player.velocity) return null;
            return { gw: gw };
        } catch (err) {
            return null;
        }
    }

    findMoveSystem(gw) {
        try {
            const systems = gw.systemsManager && gw.systemsManager.activeSystems;
            if (!systems) return null;
            const FP = /this\.vel\.lerp\(a,l\)/;
            for (let i = 0; i < systems.length; i++) {
                const s = systems[i];
                if (!s || s.gameWorld !== gw || !s.playerMoveSystem) continue;
                const m = s.playerMoveSystem;
                if (m && m.execute && typeof m.execute.toString === 'function' && FP.test(m.execute.toString())) return m;
            }
            for (let i = 0; i < systems.length; i++) {
                const s = systems[i];
                if (!s || !s.execute || typeof s.execute !== 'function' || !s.execute.toString) continue;
                if (s.gameWorld === gw && FP.test(s.execute.toString())) return s;
            }
        } catch (err) {}
        return null;
    }

    onIce(gw) {
        try {
            const p = gw.player;
            const bid = p.collision && p.collision.blockPlayerStoodOn;
            if (!bid) return false;
            const blk = gw.structuredItems && gw.structuredItems.blocks && gw.structuredItems.blocks[bid];
            return !!(blk && typeof blk.slipperiness === 'number' && blk.slipperiness < 1);
        } catch (err) {
            return false;
        }
    }

    wrap(gw) {
        try {
            if (this.iwSys && this.iwSys.gameWorld === gw && this.iwSys.execute && this.iwSys.execute.name === 'iwWrappedExecute') return true;
            const sys = this.findMoveSystem(gw);
            if (!sys) return false;
            const orig = sys.execute;
            this.iwSys = sys;
            this.iwOrigExec = orig;
            const self = this;
            sys.execute = function iwWrappedExecute() {
                try {
                    const g = this.gameWorld;
                    if (g && g.player && g.player.velocity && self.onIce(g)) {
                        g.player.velocity.slipperiness = 1;
                    }
