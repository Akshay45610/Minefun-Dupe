        this.ID_NAMES = {
            1046: 'Blue Bed',
            1048: 'Green Bed',
            1050: 'Light Blue Bed',
            1052: 'Orange Bed',
            1054: 'Purple Bed',
            1056: 'White Bed',
            1058: 'Yellow Bed',
            640:  'Red Bed'
        };

        this.ID_COLORS = {
            1046: '#0088ff',
            1048: '#00ff22',
            1050: '#00e5ff',
            1052: '#ff8800',
            1054: '#aa00ff',
            1056: '#ffffff',
            1058: '#ffff00',
            640:  '#ff0000'
