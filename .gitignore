        }
        const ctx = this.getCtx();
        if (!ctx) {
            this.timer = setTimeout(() => this.tick(), this.SCAN_MS);
            return;
        }
        const gw = ctx.gw;
        let alive = false;
        try {
            const sm = gw.systemsManager;
            if (sm && sm.activeSystems) {
                for (let i = 0; i < sm.activeSystems.length; i++) {
                    if (sm.activeSystems[i] === this.system) {
                        alive = true;
                        break;
                    }
                }
            }
        } catch (err) {}
        if (this.system && (this.system.gameWorld !== gw || !alive)) {
            this.unpatch();
        }
        if (!this.system) {
            const sys = this.getSystem(gw);
            if (sys) {
                this.patch(sys);
                this.hookEmitter(gw);
                if (!this.logged) {
                    this.logged = true;
                    this.log('hooked block system');
                }
            }
        }
        this.timer = setTimeout(() => this.tick(), this.SCAN_MS);
    }

    onEnable() {
        this.onDisable();
        this.log('enabled');
        this.tick();
    }

    onDisable() {
        if (this.timer) {
            clearTimeout(this.timer);
            this.timer = 0;
        }
        this.unpatch();
        this.logged = false;
        this.log('disabled');
    }

    onSettingsChange() {}
};

// ------------------------------ Module Manager ------------------------------
    var h = {
    modules: {},
    STORAGE_KEY: "Client_Module_Settings",
// You can custom keybind loader
    defaultKeybinds: {
        "Fly": "",
        "Timer": "",
        "Instabreak": "",
        "Aimbot": "",
        "Spider": "",
        "Freecam": "",
        "Fullbright": "",
        "Clickfast": ""
    },

    addModules(...classes) {
        for (let cls of classes) {
            let mod = new cls();
            this.modules[mod.name] = mod;
        }
    },
    saveSettings() {
        let saveData = {};
        for (let name in this.modules) {
            let mod = this.modules[name];
            saveData[name] = {
                enabled: !!mod.isEnabled,
                keybind: mod.keybind || null
            };
        }
        localStorage.setItem(this.STORAGE_KEY, JSON.stringify(saveData));
    },
    loadSettings() {
        let saved = localStorage.getItem(this.STORAGE_KEY);
        if (!saved) return;

        try {
            let saveData = JSON.parse(saved);
            for (let name in saveData) {
                let mod = this.modules[name];
                if (!mod) continue;
                if (saveData[name].keybind !== undefined) {
                    mod.keybind = saveData[name].keybind;
                }
                if (saveData[name].enabled) {
                    this.enableModuleSafely(name);
                }
            }
        } catch (e) {
            console.warn("[Client] Lỗi khi đọc file lưu:", e);
        }
    },

    handleKeyPress(code) {
        for (let name in this.modules) {
            let mod = this.modules[name];
            if (mod.waitingForBind) {
                mod.keybind = code === "Escape" ? null : code;
                mod.waitingForBind = false;
                this.saveSettings();
            } else if (mod.keybind === code) {
                this.toggleModuleSafely(name);
            }
        }
    },

    enableModuleSafely(name) {
        let mod = this.modules[name];
        if (!mod || mod.isEnabled) return;
        try {
            mod.isEnabled = true;
            if (typeof mod.enable === "function") mod.enable();
            else if (typeof mod.onEnable === "function") mod.onEnable();
        } catch (err) {
            console.warn(`[Client] Không thể bật ${name}:`, err);
        }
    },

    toggleModuleSafely(name) {
        let mod = this.modules[name];
        if (!mod) return;
        try {
            if (typeof mod.toggle === "function") {
                mod.toggle();
            } else if (mod.isEnabled) {
                mod.isEnabled = false;
                if (typeof mod.disable === "function") mod.disable();
                else if (typeof mod.onDisable === "function") mod.onDisable();
            } else {
                this.enableModuleSafely(name);
            }
            this.saveSettings();
        } catch (err) {
            console.warn(`[Client] Lỗi toggle module ${name}:`, err);
        }
    },

    applyDefaultKeybinds() {
        for (let name in this.defaultKeybinds) {
            if (this.modules[name]) {
                this.modules[name].keybind = this.defaultKeybinds[name];
            }
        }
    },

    init() {
        this.addModules(
            // Visual
            ModArraylist, ModWatermark, ModClickGUI, ModNoFog, ModChams, ModTracers,
            ModFreecam, ModXray, ModInterface, ModBlockOutline, ModFullbright,ModBetterCam,
            // Movement
            ModAirjumppatch, Modantivoid,ModClutch, ModVelocity, ModFly, ModSpeed, ModNoClip, ModTimer, ModHighJump, ModGroundSpeed, ModSpider, ModScaffold, ModAutoSprint, ModStep,Modicewalk,
            // Combat
            ModLegitKillAura, ModGunModifier, ModAimbot, Modautoclicker,
            // Misc
            ModInstabreak, ModNuker, ModAdBypass, ModFreeHeadcoins, ModFill, ModNoHunger, ModNoDrown, ModInstantRespawn, ModShopAnywhere, ModSelfHarm, ModBlockFinder,ModBedESP, ModAirPlace,
            // Fun
            ModWeatherScreen, ModKeystrokes, ModHitParticles, ModFPSBoost,
            // Menuspatch
            ModCrafting, ModDyeingTable, ModCuttingTable,
            // World
            ModFastBreak,ModAntiBan
        );
        this.applyDefaultKeybinds();
        this.loadSettings();

        c.on("render", () => {
            for (let name in this.modules) {
                let mod = this.modules[name];
                if (mod.isEnabled && mod.onRender) mod.onRender();
            }
        });

        c.on("keydown", this.handleKeyPress.bind(this));

        c.on("setting.update", () => {
            for (let name in this.modules) {
                let mod = this.modules[name];
                if (mod.isEnabled && mod.onSettingUpdate) mod.onSettingUpdate();
            }
            this.saveSettings();
        });

        const immediateModules = ["Arraylist", "Interface"];
        immediateModules.forEach(name => this.enableModuleSafely(name));

        setTimeout(() => {
            const delayedModules = [];    //<--You can custom feature loader
            delayedModules.forEach(name => this.enableModuleSafely(name));
        }, 2500);
    }
};
    // ------------------------------ Main Class ------------------------------
    var se = class {
        constructor() { this.version = "1.0.55"; this.init(); }
        init() {
            setInterval(() => { c.emit("render"); }, 1000 / 60);
            window.addEventListener("keydown", e => { c.emit("keydown", e.code); }, {capture:true});
            h.init(); p.init(); this.packets = p; this.moduleManager = h; this.hooks = o;
        }
        disable() { }
    };

    function le() { window.TVClient = new se(); }
    if (document.readyState === "complete" || document.readyState === "interactive") le();
    else document.addEventListener("DOMContentLoaded", () => { setTimeout(le, 1000); });
})();
//Chúc mọi người chơi vui vẻ với bản hack ☠TVClient📺
