                        if (this.options["Show Box"]) {
                            this.ctx.save();
                            this.ctx.strokeStyle = "rgba(0, 0, 0, 0.8)";
                            this.ctx.lineWidth = 3;
                            this.ctx.strokeRect(boxX, boxY, boxWidth, boxHeight);

                            this.ctx.strokeStyle = tracerColor;
                            this.ctx.lineWidth = 1.5;
                            this.ctx.strokeRect(boxX, boxY, boxWidth, boxHeight);
                            this.ctx.restore();
                        }

                        let showName = this.options["Show Name"];
                        let showDist = this.options["Show Distance"];

                        if (showName || showDist) {
                            let pName = p.name || (isBot ? "Mob" : "Player");
                            let text = "";
                            if (showName && showDist) text = `${pName} [${Math.round(dist)}m]`;
                            else if (showName) text = pName;
                            else if (showDist) text = `[${Math.round(dist)}m]`;

                            this.ctx.save();
                            this.ctx.font = "bold 11px system-ui, sans-serif";
                            let textWidth = this.ctx.measureText(text).width;
                            let padding = 4;
                            let tagWidth = textWidth + padding * 2;
                            let tagHeight = 16;
                            let tagX = feet2D.x - tagWidth / 2;
                            let tagY = boxY - 20;

                            this.ctx.fillStyle = "rgba(10, 8, 12, 0.85)";
                            this.ctx.fillRect(tagX, tagY, tagWidth, tagHeight);

                            this.ctx.strokeStyle = tracerColor;
                            this.ctx.lineWidth = 1;
                            this.ctx.strokeRect(tagX, tagY, tagWidth, tagHeight);

