var ModFullbright = class extends a {
    constructor() {
        super("Fullbright", "Visual");
        this.desc = "Makes the world fully bright using Gamma.";

        this.FB_GAMMA = 10;
        this.fbLight = null;
        this.fbMin = null;
        this.fbOrigMin = 0.2;
        this.fbRaw = null;
        this.fbWritten = null;
        this.fbAmount = 0;
        this.fbTarget = 0;
        this.fbRaf = 0;
        this.fbLastT = 0;
        this.fbScanFrames = 0;
    }

    lift(x) {
        x = Math.min(1, Math.max(0, x));
        return 1 - Math.pow(1 - x, this.FB_GAMMA);
    }

    getGameWorld() {
        try {
            const appEl = document.getElementById('app');
            const app = appEl && appEl.__vue_app__;
            const pinia = app && app.config && app.config.globalProperties && app.config.globalProperties.$pinia;
            if (!pinia || !pinia._s) return null;
            const store = pinia._s.get('gameState');
            const gw = store && store.gameWorld;
            return gw && gw.threeScene && gw.threeScene.scene ? gw : null;
        } catch (err) {
            return null;
        }
    }

    findUniforms() {
        try {
            const gw = this.getGameWorld();
            const scene = gw && gw.threeScene && gw.threeScene.scene;
            if (!scene || typeof scene.traverse !== 'function') return null;
            let light = null;
            let min = null;
            let budget = 4000;

            const stack = [scene];
            while (stack.length && !(light && min) && budget > 0) {
                const obj = stack.pop();
                if (!obj) continue;
                budget--;
                if (obj.isMesh && !obj.isCamera && !obj.isLight) {
                    const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
                    for (let i = 0; i < mats.length; i++) {
                        const u = mats[i] && mats[i].uniforms;
                        if (!u) continue;
                        if (u.u_lightLevel && u.u_lightLevel.value && typeof u.u_lightLevel.value.set === 'function') {
                            if (!light) light = u.u_lightLevel;
                            if (u.u_lightLevelMin && !min) min = u.u_lightLevelMin;
                        }
                    }
                }
                if (obj.children && obj.children.length) {
                    for (let i = 0; i < obj.children.length; i++) stack.push(obj.children[i]);
                }
            }
            return light || min ? { light: light, min: min } : null;
        } catch (err) {
            return null;
        }
    }

    tick(now) {
        const dt = Math.min(0.05, ((now - this.fbLastT) / 1000) || 0);
        this.fbLastT = now;
        if (!this.fbLight) {
            if (this.isEnabled) {
                if (this.fbScanFrames++ % 60 === 0) {
                    const found = this.findUniforms();
                    if (found) {
                        this.fbLight = found.light;
                        this.fbMin = found.min;
                        this.fbOrigMin = this.fbMin && typeof this.fbMin.value === 'number' ? this.fbMin.value : 0.2;
                        this.fbRaw = { x: this.fbLight.value.x, y: this.fbLight.value.y, z: this.fbLight.value.z };
                        this.fbWritten = { x: this.fbRaw.x, y: this.fbRaw.y, z: this.fbRaw.z };
                        console.log('[Full Bright] light uniforms hooked');
                    }
                }
                this.fbRaf = requestAnimationFrame((t) => this.tick(t));
            } else {
                this.fbRaf = 0;
            }
            return;
        }
        this.fbAmount += (this.fbTarget - this.fbAmount) * Math.min(1, dt * 14);
        if (Math.abs(this.fbAmount - this.fbTarget) < 0.0015) this.fbAmount = this.fbTarget;
        try {
            const v = this.fbLight.value;
            if (this.fbRaw) {
                const isRaw =
                    Math.abs(v.x - this.fbWritten.x) > 1e-5 ||
                    Math.abs(v.y - this.fbWritten.y) > 1e-5 ||
                    Math.abs(v.z - this.fbWritten.z) > 1e-5;
                if (isRaw) {
                    this.fbRaw.x = v.x;
                    this.fbRaw.y = v.y;
                    this.fbRaw.z = v.z;
                }
                const rx = this.lift(this.fbRaw.x);
                const ry = this.lift(this.fbRaw.y);
                const rz = this.lift(this.fbRaw.z);
                v.set(
                    this.fbRaw.x + (rx - this.fbRaw.x) * this.fbAmount,
                    this.fbRaw.y + (ry - this.fbRaw.y) * this.fbAmount,
                    this.fbRaw.z + (rz - this.fbRaw.z) * this.fbAmount
                );
                this.fbWritten.x = v.x;
                this.fbWritten.y = v.y;
                this.fbWritten.z = v.z;
            }
            if (this.fbMin) {
                this.fbMin.value = this.fbOrigMin + (this.lift(this.fbOrigMin) - this.fbOrigMin) * this.fbAmount;
            }
        } catch (err) {}
        if (this.fbAmount === 0 && !this.isEnabled) {
            this.fbRaf = 0;
            this.cleanup();
            return;
        }
        this.fbRaf = requestAnimationFrame((t) => this.tick(t));
    }

    cleanup() {
        if (this.fbMin) this.fbMin.value = this.fbOrigMin;
        if (this.fbLight && this.fbRaw) {
            try {
                this.fbLight.value.set(this.fbRaw.x, this.fbRaw.y, this.fbRaw.z);
            } catch (err) {}
        }
        this.fbLight = null;
        this.fbMin = null;
        this.fbRaw = null;
        this.fbWritten = null;
        this.fbOrigMin = 0.2;
        this.fbAmount = 0;
        this.fbTarget = 0;
        this.fbRaf = 0;
        this.fbScanFrames = 0;
    }

    onEnable() {
        this.onDisable();
        this.fbTarget = 1;
        this.fbAmount = 0;
        this.fbLastT = 0;
        this.fbScanFrames = 0;
        console.log('[Full Bright] enabled');
        this.fbRaf = requestAnimationFrame((t) => this.tick(t));
    }

    onDisable() {
        this.fbTarget = 0;
        if (this.fbRaf) return;
        if (this.fbLight) this.fbRaf = requestAnimationFrame((t) => this.tick(t));
    }
};
var ModTracers = class extends a {
    constructor() {
        super("Tracers", "Visual");
        this.desc = "ESP & Tracers chính xác cho người chơi và mobs";

        this.set = {};
        this.settings = [];

        this.options = {
            "Thickness (1-10)": 2,
            "Tracer Color": "#ff0000",
            "Target Players": true,
            "Target Bots/Mobs": false,
            "Show Name": true,
            "Show Distance": true,
            "Show Box": true,
            "Team Color ESP": true
        };

        this.cvs = null;
        this.ctx = null;
        this.camera = null;
        this.animFrameId = null;
        this.resizeHandler = null;
    }

    getO() {
        try {
            var app = window.app;
            var r = app._vnode.component.appContext.provides;
            var sym = Object.getOwnPropertySymbols(r).find(function(s){ return r[s] && r[s]._s; });
            if (!sym) return null;
            var o = r[sym]._s.get('gameState');
            if (!o || !o.gameWorld || !o.gameWorld.player) return null;
            return o;
        } catch(e) { return null; }
    }

    findCamera(o) {
        if (this.camera) {
            try { if (this.camera.matrixWorldInverse && this.camera.projectionMatrix) return this.camera; } catch(e){}
            this.camera = null;
        }
        try {
            var sys = o.gameWorld.systemsManager.activeSystems;
            for (var i = 0; i < sys.length; i++) {
                var s = sys[i]; if (!s) continue;
                var ks = Object.getOwnPropertyNames(s);
                for (var j = 0; j < ks.length; j++) {
                    try {
                        var v = s[ks[j]]; if (!v || typeof v !== 'object') continue;
                        if (v.isPerspectiveCamera || v.isCamera) { this.camera = v; return v; }
                        var ks2 = Object.getOwnPropertyNames(v);
                        for (var n = 0; n < ks2.length; n++) {
                            try {
                                var v2 = v[ks2[n]];
                                if (v2 && (v2.isPerspectiveCamera || v2.isCamera)) { this.camera = v2; return v2; }
                            } catch(e){}
                        }
                    } catch(e){}
                }
            }
        } catch(e){}
        return null;
    }

    worldToScreen(bx, by, bz) {
        if (!this.camera || !this.camera.projectionMatrix || !this.camera.matrixWorldInverse) return null;
        try {
            var mv = this.camera.matrixWorldInverse.elements, p = this.camera.projectionMatrix.elements;
            var vx = mv[0]*bx + mv[4]*by + mv[8]*bz + mv[12];
            var vy = mv[1]*bx + mv[5]*by + mv[9]*bz + mv[13];
            var vz = mv[2]*bx + mv[6]*by + mv[10]*bz + mv[14];
            var vw = mv[3]*bx + mv[7]*by + mv[11]*bz + mv[15];

            var cx = p[0]*vx + p[4]*vy + p[8]*vz + p[12]*vw;
            var cy = p[1]*vx + p[5]*vy + p[9]*vz + p[13]*vw;
            var cz = p[2]*vx + p[6]*vy + p[10]*vz + p[14]*vw;
            var cw = p[3]*vx + p[7]*vy + p[11]*vz + p[15]*vw;

            if (cw <= 0 || cz / cw > 1) return null;

            return {
                x: ((cx / cw) * 0.5 + 0.5) * this.cvs.width,
                y: (-(cy / cw) * 0.5 + 0.5) * this.cvs.height
            };
        } catch(e) {
            this.camera = null;
            return null;
        }
    }

    getDynamicColor(p, defaultColor) {
        if (!this.options["Team Color ESP"] || !p) return defaultColor;

        if (p.teamColor) return p.teamColor;
        if (p.color) return p.color;
        if (p.nameColor) return p.nameColor;

        let teamStr = String(p.team || p.teamName || p.teamId || '').toLowerCase();

        if (teamStr) {
            if (teamStr.includes('red') || teamStr === 'r') return '#ff3333';
            if (teamStr.includes('blue') || teamStr === 'b') return '#3388ff';
            if (teamStr.includes('green') || teamStr === 'g' || teamStr.includes('zombie')) return '#00ff00';
            if (teamStr.includes('yellow') || teamStr === 'y') return '#ffff33';
            if (teamStr.includes('cyan') || teamStr.includes('aqua')) return '#00ffff';
            if (teamStr.includes('pink') || teamStr.includes('magenta')) return '#ff66cc';
            if (teamStr.includes('purple')) return '#aa33ff';
            if (teamStr.includes('orange')) return '#ff9900';
            if (teamStr.includes('white') || teamStr.includes('human')) return '#ffffff';
        }

        let name = (p.name || '').toLowerCase();
        if (p.isInfected || p.isZombie || name.includes('zombie')) return '#00ff00';
        if (p.isHuman || name.includes('human')) return '#ffffff';

        return "#00ffffff";
    }

    createCanvas() {
        if (this.cvs) return;
        this.cvs = document.createElement('canvas');
        this.cvs.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:2147483646';
        document.body.appendChild(this.cvs);
        this.ctx = this.cvs.getContext('2d');

        this.resizeHandler = () => {
            if (this.cvs) {
                this.cvs.width = window.innerWidth;
                this.cvs.height = window.innerHeight;
