        } catch (err) {}

        try {
            Object.defineProperty(sys, 'miningSpeedMultiplier', {
                configurable: true,
                get: function () {
                    let native = 1;
                    try {
                        if (self.sysOrig && self.sysOrig.msDesc && typeof self.sysOrig.msDesc.get === 'function') {
                            native = self.sysOrig.msDesc.get.call(this);
                        } else if (self.sysOrig) {
                            native = self.sysOrig.msNative;
                        }
                    } catch (err) {}
                    let d = native * self.getFactor();
                    if (!(d > 0)) return 0;

                    const ts = self.getToolStrength(this);
                    return ts !== null && ts > 1 ? d * ts : d;
                }
            });
            this.patchedMS = true;
        } catch (err) {}

        this.system = sys;
    }

    tick() {
        if (!this.isEnabled) {
            this.onDisable();
