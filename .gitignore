    log(msg) { console.log('[Legit KillAura] ' + msg); }

    getCtx() {
        try {
            var app = window.app;
            if (!app) {
                const appEl = document.getElementById('app');
                app = appEl && appEl.__vue_app__;
            }
            const r = app._vnode.component.appContext.provides;
            const sym = Object.getOwnPropertySymbols(r).find(function(s){ return r[s] && r[s]._s; });
            if (!sym) return null;
            const gs = r[sym]._s.get('gameState');
            const gw = gs && gs.gameWorld;
            if (!gs || !gw || !gw.player || !gw.server || typeof gw.server.sendData !== 'function') return null;
            return { gs: gs, gw: gw };
        } catch (err) { return null; }
    }

    getPlayerRange() {
        const r = parseFloat(this.options["Range Player"]);
        return (!isNaN(r) && r >= 1) ? r + 0.1 : 4.1;
    }

    getMobRange() {
        const r = parseFloat(this.options["Range Mob/Bot"]);
        return (!isNaN(r) && r >= 1) ? r + 0.1 : 4.1;
    }

    isRotationFast() { return this.options["Rotation"] === 'Fast'; }

    getPos3(obj) {
        if (!obj) return null;
        if (typeof obj.x === 'number' && typeof obj.y === 'number' && typeof obj.z === 'number') return obj;
        return obj.position ? this.getPos3(obj.position) : null;
    }

    getPlayerPos(p) {
        return this.getPos3(p && p.position) || this.getPos3(p && p.model) || this.getPos3(p && p.model && p.model.body);
    }

    getMobPos(m) {
        return this.getPos3(m && m.model) || this.getPos3(m && m.body) || this.getPos3(m && m.self) || this.getPos3(m);
    }

    isGreenName(entity) {
        if (!this.options["Ignore Teammates"] || !entity) return false;
        try {
            if (entity.isTeammate || entity.team === 'green' || entity.team === 'zombie' || entity.isZombie) return true;
            if (entity.teamColor && (entity.teamColor === 'green' || entity.teamColor === '#00ff00' || entity.teamColor === '#008000')) return true;

            if (entity.nametagColor && (entity.nametagColor === 'green' || entity.nametagColor === '#00ff00' || entity.nametagColor === '#008000')) return true;

            const el = entity.nametagElement || entity.nameElement || (entity.model && entity.model.nametagElement);
            if (el) {
                const style = window.getComputedStyle(el);
                const color = style.color;
                if (color === 'rgb(0, 255, 0)' || color === 'rgb(0, 128, 0)' || el.classList.contains('green-name') || el.classList.contains('text-green-500')) {
                    return true;
                }
            }

            if (entity.mobRawData) {
                if (entity.mobRawData.isTeammate || entity.mobRawData.team === 'green' || entity.mobRawData.isZombie) return true;
            }
        } catch (err) {}
        return false;
    }

    getMobHitbox(m) {
        try {
            const hd = m && m.mobRawData && m.mobRawData.hitboxData;
            if (!hd) return null;
            const w = typeof hd.width === 'number' ? hd.width : 0.6;
            const h = typeof hd.height === 'number' ? hd.height : 1.8;
            const d = typeof hd.depth === 'number' ? hd.depth : 0.6;
            let minY = 0, maxY = h;
            try {
                const mesh = typeof hd.getHitbox === 'function' ? hd.getHitbox() : null;
                if (mesh && typeof mesh.hitboxMinYOffset === 'number') minY = mesh.hitboxMinYOffset;
                if (mesh && typeof mesh.hitboxMaxYOffset === 'number') maxY = mesh.hitboxMaxYOffset;
            } catch (err) {}
            return {
                half: { x: w / 2, y: (maxY - minY) / 2, z: d / 2 },
                aimOffset: (minY + maxY) / 2
            };
        } catch (err) { return null; }
    }

    getHalfExtents(m) {
        const hb = this.getMobHitbox(m);
        if (hb) return hb.half;
        const w = typeof m.hitboxWidth === 'number' ? m.hitboxWidth : 0.6;
        const h = typeof m.hitboxHeight === 'number' ? m.hitboxHeight : 1.8;
        const d = typeof m.hitboxDepth === 'number' ? m.hitboxDepth : 0.6;
        return { x: w / 2, y: h / 2, z: d / 2 };
    }

    getMobAimYOffset(m) {
        const hb = this.getMobHitbox(m);
        if (hb) return hb.aimOffset;
        const min = m.hitboxMinYOffset;
        const max = m.hitboxMaxYOffset || m.hitboxHeight;
        if (typeof min === 'number' && typeof max === 'number') return (min + max) / 2;
        const h = typeof m.hitboxHeight === 'number' ? m.hitboxHeight : 1.8;
        return h / 2;
    }

    getEye(gw, p) {
        try {
            const comp = p && p.physicsPosComp;
            const lp = comp && comp.lerpPosTo;
            if (lp && typeof lp.x === 'number' && typeof lp.y === 'number' && typeof lp.z === 'number') {
                return { x: lp.x, y: lp.y + ((p && p.collision && p.collision.height) || 1.8), z: lp.z };
            }
        } catch (err) {}
        try {
            const cam = gw.threeScene && (gw.threeScene.camera || gw.threeScene.activeCamera);
            const r = cam && cam.userData && cam.userData.raycastStartV3;
            if (r && typeof r.x === 'number' && typeof r.y === 'number' && typeof r.z === 'number') {
                return { x: r.x, y: r.y, z: r.z };
            }
        } catch (err) {}
        try {
            const pos = this.getPos3(p && p.position);
            if (pos) return { x: pos.x, y: pos.y + ((p && p.collision && p.collision.height) || 1.8), z: pos.z };
        } catch (err) {}
        return null;
    }

    getEntry(eye, c, half, dir) {
        let t0 = 0, t1 = Infinity;
        for (let i = 0; i < 3; i++) {
            const a = i === 0 ? 'x' : i === 1 ? 'y' : 'z';
            const o = dir[a];
            if (Math.abs(o) < 1e-9) {
                if (eye[a] < c[a] - half[a] || eye[a] > c[a] + half[a]) return -1;
            } else {
                let n = (c[a] - half[a] - eye[a]) / o;
                let f = (c[a] + half[a] - eye[a]) / o;
                if (n > f) { const tmp = n; n = f; f = tmp; }
                if (n > t0) t0 = n;
                if (f < t1) t1 = f;
                if (t0 > t1) return -1;
            }
        }
        return t0 >= 0 ? t0 : 0;
    }

    getShapesFor(def, bid) {
        switch (def.style) {
            case this.LKA_STYLE_ARBITARY: case this.LKA_STYLE_DOOR: case this.LKA_STYLE_TRAP_DOOR:
                return (def.geom && def.geom.AABBs) || null;
            case this.LKA_STYLE_STAIRS: return this.LKA_STAIRS_AABBS[(bid >> 11) & 63] || null;
            case this.LKA_STYLE_LADDER: return this.LKA_LADDER_AABBS[(6144 & bid) >> 11] || null;
            case this.LKA_STYLE_SLAB: return this.LKA_SLAB_AABBS[(14336 & bid) >> 11] || null;
            case this.LKA_STYLE_CROSS: return this.LKA_STYLE_CROSS_AABBS;
            case this.LKA_STYLE_GARDEN: return this.LKA_STYLE_GARDEN_AABBS;
            case this.LKA_STYLE_CARPET: return this.LKA_STYLE_CARPET_AABBS;
            case this.LKA_STYLE_FOLIAGE: return null;
            default: return this.LKA_STYLE_FULL_AABBS;
        }
    }

    checkRl(e, t, n, r, i, a, o, s, c, box) {
        let u = e, d = t, f = n, p = 0;
        if (!(e >= box.min[r] && e <= box.max[r])) {
            const q = Math.abs(e - box.min[r]), w = Math.abs(e - box.max[r]);
            p = Math.abs(Math.min(q, w) / o);
            u += o * p; d += s * p; f += c * p;
        }
        return (u >= box.min[r] && u <= box.max[r]) && (d >= box.min[i] && d <= box.max[i]) && (f >= box.min[a] && f <= box.max[a]) ? { position: [u, d, f], ratio: p } : false;
    }

    checkLl(box, px, py, pz, dx, dy, dz, sx, sy, sz) {
        if (this.checkRl(py, px, pz, 'y', 'x', 'z', dy, dx, dz, box)) return true;
        if (this.checkRl(px, py, pz, 'x', 'y', 'z', dx, dy, dz, box)) return true;
        return !!this.checkRl(pz, px, py, 'z', 'x', 'y', dz, dx, dy, box);
    }

    isOccluded(gw, eye, dir, far, allBlocks) {
        try {
            const cm = gw.chunkManager;
            if (!cm || typeof cm.getBlock !== 'function') return false;
            const defs = (gw.structuredItems && gw.structuredItems.blocks) || cm.blocks;
            if (!defs) return false;
            const len = Math.sqrt(dir.x * dir.x + dir.y * dir.y + dir.z * dir.z);
            if (len < 1e-9) return false;
            const ox = dir.x / len, oy = dir.y / len, oz = dir.z / len;
            let d = Math.floor(eye.x), f = Math.floor(eye.y), p = Math.floor(eye.z);
            const mx = ox > 0 ? 1 : -1, my = oy > 0 ? 1 : -1, mz = oz > 0 ? 1 : -1;
            const ax = Math.abs(1 / ox), ay = Math.abs(1 / oy), az = Math.abs(1 / oz);
            let tMaxX = ax < 1 / 0 ? ax * (mx > 0 ? d + 1 - eye.x : eye.x - d) : 1 / 0;
            let tMaxY = ay < 1 / 0 ? ay * (my > 0 ? f + 1 - eye.y : eye.y - f) : 1 / 0;
            let tMaxZ = az < 1 / 0 ? az * (mz > 0 ? p + 1 - eye.z : eye.z - p) : 1 / 0;
            let t = 0, guard = 0;
            while (t <= far && guard < this.LKA_OCC_GUARD) {
                if (t > 0.0001) {
                    const bid = cm.getBlock(d, f, p);
                    if (bid && defs[bid]) {
                        const def = defs[bid];
                        if (def.style !== this.LKA_STYLE_INVIS_CUBE && def.style !== this.LKA_STYLE_FLUID && (allBlocks === true || !def.physTransp)) {
                            if (def.style === this.LKA_STYLE_CUBE) return true;
                            const shapes = this.getShapesFor(def, bid);
                            if (shapes) {
                                const px = eye.x + t * ox, py = eye.y + t * oy, pz = eye.z + t * oz;
                                for (let si = 0; si < shapes.length; si++) {
                                    const s = shapes[si];
                                    if (!s) continue;
                                    const box = this.lkaOccBox;
                                    box.min.x = d + s[0]; box.min.y = f + s[1]; box.min.z = p + s[2];
                                    box.max.x = d + s[3]; box.max.y = f + s[4]; box.max.z = p + s[5];
                                    if (this.checkLl(box, px, py, pz, ox, oy, oz, mx, my, mz)) return true;
                                }
                            }
                        }
                    }
                }
                if (tMaxX < tMaxY) {
                    if (tMaxX < tMaxZ) { d += mx; t = tMaxX; tMaxX += ax; } else { p += mz; t = tMaxZ; tMaxZ += az; }
                } else {
                    if (tMaxY < tMaxZ) { f += my; t = tMaxY; tMaxY += ay; } else { p += mz; t = tMaxZ; tMaxZ += az; }
                }
                guard++;
            }
        } catch (err) {}
        return false;
    }

    checkBoxPre(eye, center, half, reach) {
        return Math.abs(center.x - eye.x) <= reach + half.x + this.LKA_RANGE_EPS &&
            Math.abs(center.y - eye.y) <= reach + half.y + this.LKA_RANGE_EPS &&
            Math.abs(center.z - eye.z) <= reach + half.z + this.LKA_RANGE_EPS;
    }

    rankTarget(gw, eye, cand, reach) {
        const c = cand.center;
        const ccx = c.x - eye.x, ccy = c.y - eye.y, ccz = c.z - eye.z;
        const cLen = Math.sqrt(ccx * ccx + ccy * ccy + ccz * ccz);
        if (cLen < this.LKA_OVERLAP_EPS) return { far: 0, aim: c };
        const hLen = Math.sqrt(ccx * ccx + ccz * ccz);
        const hMH = Math.max(cand.half.x, cand.half.z);
        if (hLen - hMH > reach + this.LKA_RANGE_EPS) return null;
        if (Math.abs(ccy) > reach + cand.half.y) return null;
        const offsets = [this.LKA_AIM_UP, this.LKA_AIM_TOP, 0, -this.LKA_AIM_DOWN];
        for (let oi = 0; oi < offsets.length; oi++) {
            const aim = { x: c.x, y: c.y + cand.half.y * offsets[oi], z: c.z };
            const ax = aim.x - eye.x, ay = aim.y - eye.y, az = aim.z - eye.z;
            const len = Math.sqrt(ax * ax + ay * ay + az * az);
            if (len < 1e-9) continue;
            const dir = { x: ax / len, y: ay / len, z: az / len };
            const entry = this.getEntry(eye, c, cand.half, dir);
            if (entry < 0) continue;
            const far = Math.max(entry, this.LKA_FAR_EPS);
            if (this.isOccluded(gw, eye, dir, far - this.LKA_OCC_LEAD, cand.kind === 'mob')) continue;
            return { far: far, aim: aim };
        }
        return null;
    }

    pickTarget(ctx, eye) {
        const gw = ctx.gw;
        let best = null, bestFar = Infinity;

        if (this.options["Target Players"]) {
            const playerReach = this.getPlayerRange();
            try {
                if (gw.server.players && gw.server.players.forEach) {
                    const selfId = gw.player.sessionId;
                    gw.server.players.forEach((p, sid) => {
                        if (sid === selfId || !p || p.isAlive === false) return;
                        if (this.isGreenName(p)) return;
                        const pos = this.getPlayerPos(p);
                        if (!pos) return;
                        const half = this.LKA_PLAYER_HALF;
                        const center = { x: pos.x, y: pos.y + half.y, z: pos.z };
                        const aim = { x: pos.x, y: center.y + half.y * this.LKA_AIM_UP, z: pos.z };
                        if (!this.checkBoxPre(eye, center, half, playerReach)) return;
                        const r = this.rankTarget(gw, eye, { center: center, half: half, aim: aim, kind: 'player' }, playerReach);
                        if (r && r.far < bestFar) { bestFar = r.far; best = { kind: 'player', id: sid, ref: p, center: center, half: half, aim: r.aim, reach: playerReach }; }
                    });
                }
            } catch (err) {}
        }

        if (this.options["Target Bots/Mobs"]) {
            const mobReach = this.getMobRange();
            try {
                if (gw.chunkManager && gw.chunkManager.mobsManagerSystem &&
                    gw.chunkManager.mobsManagerSystem.allMobs && gw.chunkManager.mobsManagerSystem.allMobs.forEach) {
                    gw.chunkManager.mobsManagerSystem.allMobs.forEach((m, id) => {
                        if (!m || m.isDying) return;
                        if (this.isGreenName(m)) return;
                        const pos = this.getMobPos(m);
                        if (!pos) return;
                        const half = this.getHalfExtents(m);
                        const center = { x: pos.x, y: pos.y + this.getMobAimYOffset(m), z: pos.z };
                        const aim = { x: pos.x, y: center.y + half.y * this.LKA_AIM_UP, z: pos.z };
                        if (!this.checkBoxPre(eye, center, half, mobReach)) return;
                        const r = this.rankTarget(gw, eye, { center: center, half: half, aim: aim, kind: 'mob' }, mobReach);
                        if (r && r.far < bestFar) { bestFar = r.far; best = { kind: 'mob', id: id, ref: m, center: center, half: half, aim: r.aim, reach: mobReach }; }
                    });
                }
            } catch (err) {}
        }

        return best;
    }

    getTargetGeo(ctx, t) {
        try {
            if (t.kind === 'player') {
                if (!this.options["Target Players"]) return null;
                const p = ctx.gw.server.players && ctx.gw.server.players.get(t.id);
                if (!p || p.isAlive === false || this.isGreenName(p)) return null;
                const pos = this.getPlayerPos(p);
                if (!pos) return null;
                const half = this.LKA_PLAYER_HALF;
                const center = { x: pos.x, y: pos.y + half.y, z: pos.z };
                const aim = { x: pos.x, y: center.y + half.y * this.LKA_AIM_UP, z: pos.z };
                return { center: center, aim: aim, half: half, ref: p, reach: this.getPlayerRange() };
            } else if (t.kind === 'mob') {
                if (!this.options["Target Bots/Mobs"]) return null;
                const mobs = ctx.gw.chunkManager && ctx.gw.chunkManager.mobsManagerSystem &&
                    ctx.gw.chunkManager.mobsManagerSystem.allMobs;
                const m = mobs && mobs.get(t.id);
                if (!m || m.isDying || this.isGreenName(m)) return null;
                const pos = this.getMobPos(m);
                if (!pos) return null;
                const half = this.getHalfExtents(m);
                const center = { x: pos.x, y: pos.y + this.getMobAimYOffset(m), z: pos.z };
                const aim = { x: pos.x, y: center.y + half.y * this.LKA_AIM_UP, z: pos.z };
                return { center: center, aim: aim, half: half, ref: m, reach: this.getMobRange() };
            }
        } catch (err) { return null; }
        return null;
    }

    normYaw(y) { const r = y % (2 * Math.PI); return r < 0 ? r + 2 * Math.PI : r; }
    shortArc(a) { return (((a + Math.PI) % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI) - Math.PI; }

    faceTarget(gw, p, yaw, pitch) {
        try {
            const targetYaw = this.normYaw(yaw);
            const realYaw = p && p.rotation ? this.normYaw(p.rotation.y) : targetYaw;
            const realPitch = p && p.rotation ? p.rotation.x : pitch;

            const realYawMoved = this.lkaFaceRealYaw !== null && Math.abs(this.shortArc(realYaw - this.lkaFaceRealYaw)) > this.LKA_FACE_EPS;
            const realPitchMoved = this.lkaFaceRealPitch !== null && Math.abs(realPitch - this.lkaFaceRealPitch) > this.LKA_FACE_EPS;
            const realMoved = realYawMoved || realPitchMoved;
            const facingLost = realMoved && this.lkaFaceYaw !== null && Math.abs(this.shortArc(realYaw - this.lkaFaceYaw)) > this.LKA_FACE_EPS;
            const pitchLost = realMoved && this.lkaFacePitch !== null && Math.abs(realPitch - this.lkaFacePitch) > this.LKA_FACE_EPS;
            const need = this.lkaFaceYaw === null || facingLost || pitchLost ||
                Math.abs(this.shortArc(targetYaw - this.lkaFaceYaw)) > this.LKA_FACE_EPS ||
                Math.abs(pitch - this.lkaFacePitch) > this.LKA_FACE_EPS;

            if (!need) return;
            gw.server.sendData(1, { r: [Number(pitch.toFixed(3)), Number(targetYaw.toFixed(3))] });
            this.lkaFaceYaw = targetYaw; this.lkaFacePitch = pitch;
            this.lkaFaceRealYaw = realYaw; this.lkaFaceRealPitch = realPitch;
        } catch (err) {}
    }

    thirdPersonFrame(sys) {
        if (this.lkaVisYaw === null || !sys || !sys.model) return;
        const m = sys.model;
        const d = (((this.lkaVisYaw - m.rotation.y) + Math.PI) % (2 * Math.PI) + (2 * Math.PI)) % (2 * Math.PI) - Math.PI;
        m.rotation.y = m.rotation.y + d * this.LKA_VIS_TURN;
        const head = sys.headObj3D;
        if (head && this.lkaVisPitch !== null) {
            head.rotation.x = Math.max(this.LKA_VIS_HEAD_MIN, Math.min(this.LKA_VIS_HEAD_MAX, this.lkaVisPitch));
        }
    }

    wrapThirdPerson(gw) {
        try {
            const systems = gw.systemsManager && gw.systemsManager.activeSystems;
            if (!systems || !Array.isArray(systems)) return null;
            for (let i = 0; i < systems.length; i++) {
                const s = systems[i];
                if (s && s.gameWorld === gw && s.execute && typeof s.execute === 'function' && /PLAYER_ROTATION_SPEED_MULTIPLIER/.test(s.execute.toString())) {
                    if (s.execute.name === 'lkaThirdWrappedExecute') { this.lkaThirdSys = s; return s; }
                    const orig = s.execute;
                    const self = this;
                    s.execute = function lkaThirdWrappedExecute() {
                        const r = orig.apply(this, arguments);
                        try { self.thirdPersonFrame(this); } catch (err) {}
                        return r;
                    };
                    this.lkaThirdSys = s; this.lkaThirdOrigExec = orig;
                    return s;
                }
            }
            return null;
        } catch (err) { return null; }
    }

    unwrapThirdPerson() {
        try {
            if (this.lkaThirdSys && this.lkaThirdOrigExec && this.lkaThirdSys.execute && this.lkaThirdSys.execute.name === 'lkaThirdWrappedExecute') {
                this.lkaThirdSys.execute = this.lkaThirdOrigExec;
            }
        } catch (err) {}
        this.lkaThirdSys = null; this.lkaThirdOrigExec = null;
    }

    ensureThirdPerson(gw) {
        if (!this.isEnabled || !gw) { this.unwrapThirdPerson(); return; }
        if (!this.wrapThirdPerson(gw)) this.unwrapThirdPerson();
    }

    findSender(gw) {
        try {
            if (this.lkaSender && this.lkaSenderGw === gw && this.lkaSender.physDataToSend) return this.lkaSender;
            const systems = gw.systemsManager && gw.systemsManager.activeSystems;
            if (!systems || !Array.isArray(systems)) return null;
            for (let i = 0; i < systems.length; i++) {
                const s = systems[i];
                if (s && s.server && s.server.sendData && Array.isArray(s.physDataToSend) && typeof s.accumulator === 'number' && typeof s.prevLeftMB === 'boolean') {
                    this.lkaSender = s; this.lkaSenderGw = gw;
                    return s;
                }
            }
            return null;
        } catch (err) { return null; }
    }

    swing(gw) {
        try {
            if (gw.eventEmitter && typeof gw.eventEmitter.emit === 'function') gw.eventEmitter.emit(409);
            const sender = this.findSender(gw);
            if (!sender) return false;
            gw.server.sendData(1, { l: 1 });
            sender.prevLeftMB = true;
            return true;
        } catch (err) { return false; }
    }

    sendHit(ctx, target, eye, dir, far) {
        try {
            const gw = ctx.gw;
            const t = Number(gw.time && gw.time.localServerTimeMs) || 0;
            const s = t - 130;
            if (target.kind === 'mob') {
                const m = target.ref;
                const rotY = m && m.model && typeof m.model.rotation.y === 'number' ? m.model.rotation.y : 0;
                gw.server.sendData(522, [eye.x, eye.y, eye.z, dir.x, dir.y, dir.z, s, Number(target.id), rotY]);
            } else {
                gw.server.sendData(13, [s, eye.x, eye.y, eye.z, dir.x, dir.y, dir.z, far, target.id]);
            }
        } catch (err) {}
    }

    step(ctx) {
        const gw = ctx.gw;
        const p = gw.player;
        const eye = this.getEye(gw, p);
        if (!eye) { this.lkaVisYaw = null; this.lkaVisPitch = null; return; }

        this.lkaVisYaw = null;
        this.lkaVisPitch = null;
        let target = null;

        if (this.lkaTarget) {
            const geo = this.getTargetGeo(ctx, this.lkaTarget);
            const r = geo && this.rankTarget(gw, eye, { center: geo.center, half: geo.half, aim: geo.aim, kind: this.lkaTarget.kind }, geo.reach);
            if (r) {
                target = { kind: this.lkaTarget.kind, id: this.lkaTarget.id, ref: geo.ref, center: geo.center, half: geo.half, aim: r.aim, reach: geo.reach };
            } else {
