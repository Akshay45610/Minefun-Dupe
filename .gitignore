    var ModAimbot = class extends a {
    constructor() {
        super("Aimbot", "Combat", {
            "Closest Crosshair": "true",
            "Closest Distance": "false",
            "On Aim": "true",
            "On Shoot": "true",
            "Y Offset": 0
        });
        this.lastExecutionTime = null;
    }

    getO() {
        try {
            var app = window.app;
            var r = app._vnode.component.appContext.provides;
            var sym = Object.getOwnPropertySymbols(r).find(function(s){ return r[s] && r[s]._s; });
            if (!sym) return null;
            var gameState = r[sym]._s.get('gameState');
            if (!gameState || !gameState.gameWorld || !gameState.gameWorld.player) return null;
            return gameState;
        } catch(e) { return null; }
    }

    getClosestEnemyByDistance(player, playersList) {
        let closest = null, minDistance = Infinity;
        playersList.forEach(n => {
            if (!n || n === player || (n.id !== undefined && player.id !== undefined && n.id === player.id) || !n.isAlive) return;
            let pos = n.model?.position || n.position;
            if (!pos) return;

            let dist = x.calculateDistance(player.position, pos);
            if (dist < minDistance) {
                minDistance = dist;
                closest = n;
            }
        });
        return closest;
    }

    getClosestEnemyByCrosshair(player, playersList) {
        let closest = null, minAngleDiff = Infinity;
        let playerPos = player.position;
        let playerRot = player.rotation;
        if (!playerPos || !playerRot) return null;

        playersList.forEach(n => {
            if (!n || n === player || (n.id !== undefined && player.id !== undefined && n.id === player.id) || !n.isAlive) return;
            let targetPos = n.model?.position || n.position;
            if (!targetPos) return;

            let diff = { x: targetPos.x - playerPos.x, z: targetPos.z - playerPos.z };
            let targetYaw = Math.atan2(diff.x, diff.z);
            let expectedYaw = (targetYaw + Math.PI) % (2 * Math.PI);

            let currentYaw = playerRot.y;
            let angleDiff = Math.abs(expectedYaw - currentYaw);
            if (angleDiff > Math.PI) angleDiff = 2 * Math.PI - angleDiff;

            if (angleDiff < minAngleDiff) {
                minAngleDiff = angleDiff;
                closest = n;
            }
        });
        return closest;
    }

    aimAtEnemy() {
        let gameState = this.getO();
        let e = gameState?.gameWorld?.player || o?.gameWorld?.player;
        let t = gameState?.gameWorld?.server?.players || gameState?.gameWorld?.entities?.players || o?.gameWorld?.server?.players;
        if (!e || !t) return;

        let useCrosshair = this.options["Closest Crosshair"] == "true";
        let useDistance = this.options["Closest Distance"] == "true";
        let i = null;

        if (useCrosshair) {
            i = this.getClosestEnemyByCrosshair(e, t);
        } else if (useDistance) {
            i = this.getClosestEnemyByDistance(e, t);
        }

        if (i) {
            let s = i.model?.position || i.position;
            let n = e.position;
            let l = { x: s.x - n.x, z: s.z - n.z };
            let d = Math.atan2(l.x, l.z);
            let u = parseFloat(this.options["Y Offset"]) || 0;
            let y = s.y + u - n.y;
            let f = Math.hypot(l.x, l.z);
            let g = Math.atan2(y, f);
            g = Math.max(Math.min(g, Math.PI / 2), -Math.PI / 2);
            let b = (d + Math.PI) % (2 * Math.PI);
            e.rotation.y = b;
            e.rotation.x = g;
        }
    }

    onRender() {
        let gameState = this.getO();
        let player = gameState?.gameWorld?.player || o?.gameWorld?.player;

        if (player) {
            let inputs = player.inputs;
            let onAim = this.options["On Aim"] == "true";
            let onShoot = this.options["On Shoot"] == "true";

            if (onAim && inputs?.rightMB) this.aimAtEnemy();
            else if (onShoot && inputs?.leftMB) this.aimAtEnemy();
            else if (!onAim && !onShoot) this.aimAtEnemy();
        }
    }
};
var Modautoclicker = class extends a {
