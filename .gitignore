            { type: 'bool', id: 'randomizeCps', label: 'Randomize CPS' },
            { type: 'bool', id: 'breakBlocks', label: 'Break Blocks' },
            { type: 'bool', id: 'onlyWeapon', label: 'Only Hold Weapon' }
        ];

        this.acHolding = false;
        this.acTimer = null;
        this.acBlockCache = false;
        this.acBlockCacheTime = 0;
        this.acHighlightMesh = null;
        this.acHighlightFound = false;
        this.acRealListenersAttached = false;

        this._onMouseDown = this.onMouseDown.bind(this);
        this._onMouseUp = this.onMouseUp.bind(this);
    }

    log(msg) {
        console.log('[Auto Clicker] ' + msg);
    }

    getCtx() {
        try {
            const appEl = document.getElementById('app');
            const app = appEl && appEl.__vue_app__;
            const pinia = app && app.config && app.config.globalProperties && app.config.globalProperties.$pinia;
            if (!pinia || !pinia._s) return null;
            const gs = pinia._s.get('gameState');
            const inv = pinia._s.get('inventoryState');
            const gw = gs && gs.gameWorld;
            if (!gs || !gw) return null;
            return { gs: gs, gw: gw, inv: inv };
        } catch (err) {
            return null;
        }
    }

    getCanvas() {
        return document.pointerLockElement || document.querySelector('canvas');
    }

    findHighlightMesh(gw) {
        if (this.acHighlightFound) return this.acHighlightMesh;
        try {
            const sm = gw.systemsManager;
            if (!sm || !sm.activeSystems) return null;
            const sys = sm.activeSystems;
            for (let i = sys.length - 1; i >= 0; i--) {
                const s = sys[i];
                if (s && s.mesh && s.mesh.name === 'Blocks Highlighting') {
                    this.acHighlightMesh = s.mesh;
                    this.acHighlightFound = true;
                    return s.mesh;
                }
            }
        } catch (err) {}
        return null;
    }

    isLookingAtBlock() {
        const now = performance.now();
        if (now - this.acBlockCacheTime < 100) return this.acBlockCache;
        this.acBlockCacheTime = now;
        try {
            const ctx = this.getCtx();
            if (!ctx || !ctx.gw) { this.acBlockCache = false; return false; }
            const mesh = this.findHighlightMesh(ctx.gw);
            if (!mesh) { this.acBlockCache = false; return false; }
            this.acBlockCache = mesh.visible === true;
            return this.acBlockCache;
        } catch (err) {
            this.acBlockCache = false;
            return false;
        }
    }

    isHoldingWeapon() {
        try {
            const ctx = this.getCtx();
            if (!ctx || !ctx.inv) return false;
            const store = ctx.inv;
            const items = store.items;
            const selected = store.selectedItem;
            const slot = store[1] && store[1][selected];
            if (!slot || !slot.id) return false;
            const def = items[slot.id];
            if (!def) return false;
            return def.category === 852;
        } catch (err) {
            return false;
        }
    }

    dispatchClick(canvas) {
        if (!canvas) return;
        try {
            const opts = { button: 0, bubbles: false, cancelable: false, composed: false };
            canvas.dispatchEvent(new PointerEvent('pointerdown', opts));
            canvas.dispatchEvent(new MouseEvent('mousedown', opts));
            setTimeout(function () {
                try {
                    canvas.dispatchEvent(new PointerEvent('pointerup', opts));
                    canvas.dispatchEvent(new MouseEvent('mouseup', opts));
                } catch (err) {}
            }, 8);
        } catch (err) {}
    }

    clickTick() {
        if (!this.isEnabled || !this.acHolding) {
            this.stop();
            return;
        }

        const set = this.set;
        const isFastBreakEnabled = typeof fastBreakModule !== 'undefined' && fastBreakModule.enabled;

        if (isFastBreakEnabled) {
            try {
                const ctx = this.getCtx();
                if (ctx && ctx.gw && ctx.gw.player && ctx.gw.player.inputs &&
                    ctx.gw.player.inputs.leftMB === true) {
                    this.acTimer = setTimeout(() => this.clickTick(), 50);
                    return;
                }
            } catch (err) {}
        }

        if ((!set.breakBlocks || isFastBreakEnabled) && this.isLookingAtBlock()) {
            this.acTimer = setTimeout(() => this.clickTick(), 50);
            return;
        }

        if (set.onlyWeapon && !this.isHoldingWeapon()) {
            this.acTimer = setTimeout(() => this.clickTick(), 50);
            return;
        }

        const canvas = this.getCanvas();
        if (!canvas) { this.stop(); return; }

        this.dispatchClick(canvas);

        let cps = set.cps;
        if (set.randomizeCps) {
            const delta = Math.floor(Math.random() * 7) - 3;
            cps = Math.max(1, Math.min(24, cps + delta));
        }
        const interval = 1000 / cps;
        this.acTimer = setTimeout(() => this.clickTick(), interval);
    }

    start() {
        if (this.acTimer) return;
        this.clickTick();
    }

    stop() {
        if (this.acTimer) {
            clearTimeout(this.acTimer);
            this.acTimer = null;
        }
    }

    onMouseDown(e) {
        if (!this.isEnabled) return;
        if (e.button !== 0) return;
        if (!e.isTrusted) return;
        this.acHolding = true;
        this.start();
    }

    onMouseUp(e) {
        if (e.button !== 0) return;
        if (!e.isTrusted) return;
        this.acHolding = false;
        this.stop();
    }

    onEnable() {
        this.onDisable();
        this.log('enabled');
        this.acRealListenersAttached = true;
        document.addEventListener('mousedown', this._onMouseDown, true);
        document.addEventListener('mouseup', this._onMouseUp, true);
    }

    onDisable() {
        this.stop();
        this.acHolding = false;
        if (this.acRealListenersAttached) {
            document.removeEventListener('mousedown', this._onMouseDown, true);
            document.removeEventListener('mouseup', this._onMouseUp, true);
            this.acRealListenersAttached = false;
        }
        this.log('disabled');
    }

    onSettingsChange() {}
};
    // ================== MISC MODULES ==================
    var ModInstabreak = class extends a { constructor() { super("Instabreak", "Misc", null); this.originalHardness = new Map(); } onEnable() { Object.values(o.gameWorld.items).forEach(e => { if (e?.destruction) { if (!this.originalHardness.has(e)) this.originalHardness.set(e, e.destruction.durability); e.destruction.durability = 0; } }); } onDisable() { Object.values(o.gameWorld.items).forEach(e => { if (e?.destruction && this.originalHardness.has(e)) e.destruction.durability = this.originalHardness.get(e); }); } };

    var ModNuker = class extends a {
    constructor() {
        super("Nuker", "Misc", {
            "Range": 1,
            "Delay Forward": 200,
            "Delay Down": 500,
            "Delay Up": 500,
            "Auto Disable": false
        });
        this.timer = null;
        this.isLeftMouseDown = false;
        this.isArrowDownPressed = false;
        this.isSpacePressed = false;

        this.onMouseDown = (e) => {
            if (e.button === 0) this.isLeftMouseDown = true;
        };

        this.onMouseUp = (e) => {
            if (e.button === 0) this.isLeftMouseDown = false;
        };

        this.onKeyDown = (e) => {
            if (e.code === "KeyC") this.isArrowDownPressed = true;
            if (e.code === "Space") this.isSpacePressed = true;
        };

        this.onKeyUp = (e) => {
            if (e.code === "KeyC") this.isArrowDownPressed = false;
            if (e.code === "Space") this.isSpacePressed = false;
        };
    }

    onEnable() {
        window.addEventListener("mousedown", this.onMouseDown);
        window.addEventListener("mouseup", this.onMouseUp);
        window.addEventListener("keydown", this.onKeyDown);
        window.addEventListener("keyup", this.onKeyUp);
        this.step();
    }

    onDisable() {
        window.removeEventListener("mousedown", this.onMouseDown);
        window.removeEventListener("mouseup", this.onMouseUp);
        window.removeEventListener("keydown", this.onKeyDown);
        window.removeEventListener("keyup", this.onKeyUp);
        this.isLeftMouseDown = false;
        this.isArrowDownPressed = false;
        this.isSpacePressed = false;
        if (this.timer) {
            clearTimeout(this.timer);
            this.timer = null;
        }
    }

    step() {
        if (!this.isEnabled) return;

        let currentDelay = 50;
        let targets = [];

        try {
            const gw = o.gameWorld;
            if (gw && gw.player && gw.chunkManager) {
                const player = gw.player;
                const pos = player.position;

                const px = Math.floor(pos.x);
                const py = Math.floor(pos.y);
                const pz = Math.floor(pos.z);

                if (this.isLeftMouseDown) {
                    currentDelay = parseInt(this.options["Delay Forward"]) || 50;

                    const headY = Math.floor(pos.y + 1.5);
                    const rot = player.rotation || { x: 0, y: 0 };
                    const pitch = rot.x;
                    const yaw = rot.y;

                    let dx = -Math.sin(yaw) * Math.cos(pitch);
                    let dy = Math.sin(pitch);
                    let dz = -Math.cos(yaw) * Math.cos(pitch);

                    const absX = Math.abs(dx);
                    const absY = Math.abs(dy);
                    const absZ = Math.abs(dz);

                    let stepX = 0, stepY = 0, stepZ = 0;

                    if (absY > absX && absY > absZ) {
                        stepY = Math.sign(dy);
                    } else if (absX > absZ) {
                        stepX = Math.sign(dx);
                    } else {
                        stepZ = Math.sign(dz);
                    }

                    const reach = Math.max(1, parseInt(this.options["Range"]) || 3);

                    for (let i = 1; i <= reach; i++) {
                        const tx = px + (stepX * i);
                        const ty = headY + (stepY * i);
                        const tz = pz + (stepZ * i);

                        if (stepY !== 0) {
                            targets.push([tx, ty, tz]);
                        } else {
                            targets.push([tx, Math.floor(pos.y), tz]);
                            targets.push([tx, Math.floor(pos.y + 1), tz]);
                        }
                    }
                }
                else if (this.isArrowDownPressed) {
                    currentDelay = parseInt(this.options["Delay Down"]) || 500;
                    targets.push([px, py - 1, pz]);
                }
                else if (this.isSpacePressed) {
                    currentDelay = parseInt(this.options["Delay Up"]) || 500;
                    targets.push([px, py + 2, pz]);
                }

                targets.forEach(([x, y, z]) => {
                    if (gw.chunkManager.getBlock(x, y, z) !== 0) {
                        gw.chunkManager.setBlock(x, y, z, 0, true);

                        if (gw.server && typeof gw.server.sendData === 'function') {
                            gw.server.sendData(2, [x, y, z]);
                        }
                    }
                });
            }
        } catch (err) {}

        this.timer = setTimeout(() => this.step(), Math.max(0, currentDelay));
    }
};
    var ModAdBypass = class extends a { constructor() { super("AdBypass", "Misc"); } onEnable() { this._reward = this._reward || o.stores.get("adsStore").rewardCommercialVideoWrapper; o.stores.get("adsStore").rewardCommercialVideoWrapper = () => true; } onDisable() { o.stores.get("adsStore").rewardCommercialVideoWrapper = () => this._reward; } };
    var ModFreeHeadcoins = class extends a { constructor() { super("FreeHeadbuckpatch:(", "Misc"); } async onEnable() { let e = await o.network.get("users/freeSpinner"); o.stores.get("userState").user.balance.headcoins += e.data.amount; h.modules.FreeHeadcoins.disable(); } };
    var ModFill = class extends a { constructor() { super("Fill", "Misc", { Radius: 4, "Block ID": 652, "Chunk Interval": 500 }); this.lastExecutionTime = 0; } onRender() { if (!o?.gameWorld?.player) return; let e = this.options.Radius; let t = this.options["Chunk Interval"]; let i = Date.now(); if (i - this.lastExecutionTime >= t) { this.lastExecutionTime = i; let s = Object.values(o.gameWorld.player.position).splice(0, 3).map(Math.floor); for (let n = -e; n <= e; n++) for (let l = -e; l <= e; l++) for (let d = -e; d <= e; d++) { let [u, y, f] = [s[0] + n, s[1] + l, s[2] + d]; if (o.gameWorld.chunkManager.getBlock(u, y, f) == 0) o.gameWorld.chunkManager.setBlock(u, y, f, this.options["Block ID"], true, true); } } } };
    var ModNoHunger = class extends a { constructor() { super("NoHunger", "Misc", null); } onEnable() { p.listeners.NoHunger = function (e, t) { if (e == p.toServer.TIME_STEP_INFO) { if (t.m) delete t.m; if (t.s) delete t.s; if (t.j) delete t.j; } }; } onDisable() { delete p.listeners.NoHunger; } };
    var ModNoDrown = class extends a { constructor() { super("NoDrown", "Misc", null); } get damageListener() { return o.gameWorld.eventEmitter._events.get(48).values().next().value; } onRender() { if (o?.gameWorld?.eventEmitter?._events && this.damageListener.callback.toString().includes("damageToApply")) this.damageListener.callback = () => { }; } onDisable() { if (o?.gameWorld?.eventEmitter?._events) this.damageListener.callback = e => { this.damageToApply += e; }; } };
    var ModInstantRespawn = class extends a { constructor() { super("InstantRespawn", "Misc"); } get gamemode() { return location.pathname.replace("/match/", ""); } onRender() { if (o.gameWorld?.player.isAlive) return; let e = false; switch (this.gamemode) { case "one-block": o.gameWorld.server.sendData(p.toServer.ONE_BLOCK_REQUEST_RESPAWN, true); e = true; break; case "parkour": o.gameWorld.server.sendData(p.toServer.PARKOUR_REQUEST_RESPAWN, true); e = true; break; case "bedwars": o.gameWorld.server.sendData(p.toServer.BED_WARS_REQUEST_RESPAWN, true); e = true; break; case "survival": o.gameWorld.server.sendData(p.toServer.SANDBOX_REQUEST_RESPAWN, true); e = true; break; } if (e) o.stores.get("gameState").setLayoutState(0); } };
    var ModShopAnywhere = class extends a { constructor() { super("ShopAnywhere", "Misc"); } get npcSystem() { return o?.gameWorld?.systemsManager?.activeSystems.find(e => e?.isPlayerInShoppingZone); } onRender() { if (this?.npcSystem) { this._og = this._og || this.npcSystem.isPlayerInShoppingZone; if (this.npcSystem.isPlayerInShoppingZone == this._og) this.npcSystem.isPlayerInShoppingZone = () => true; } } onDisable() { if (this.npcSystem) this.npcSystem.isPlayerInShoppingZone = this._og; } };
    var ModSelfHarm = class extends a { constructor() { super("SelfHarm", "Misc", { Amount: 1 }); } onEnable() { o.gameWorld.server.msgsToSend.push(p.toServer.GOT_DAMAGE, parseFloat(this.options.Amount)); this.disable(); } };
    var ModBlockFinder = class extends a {
    constructor() {
        super("Block Finder", "Misc");
        this.desc = "Scan and render ESP for targeted blocks in world";

        this.set = {};
        this.settings = [];

        this.ALL_IDS = [1067, 572, 580, 494, 691, 1063, 571, 581, 616, 830];
        this.ACTIVE_IDS = [...this.ALL_IDS];
        this.SEARCH_RADIUS = 5;
        this.MAX_RADIUS = 30;
        this.FOV_Y = 70;
        this.BATCH_SIZE = 20;
        this.STEPS_FRAME = 80;

        this.ID_NAMES = {
            1067: 'Infernal Shard',
            572:  'Gold Block',
            580:  'Diamond Block',
            494:  'White Wool',
            691:  'Copper',
            1063: 'Screaming Obsidian',
            571:  'Gold',
            581:  'Diamond',
            616:  'Coal',
            830:  'Iron'
        };

        this.ID_COLORS = {
            1067: '#f70a41',
            572:  '#575403',
            580:  '#08fcfc',
            494:  '#ebeded',
            691:  '#f55b02',
            1063: '#230a40',
            571:  '#ffff05',
            581:  '#80DEEA',
            616:  '#050505',
            830:  '#b0afae'
        };

        this.targetBlocks = [];
        this.allBlocks = [];
        this.espOn = true;
        this.camera = null;
        this.scanState = null;
        this.lastURL = location.href;
        this.checkTick = 0;

        this.cvs = null;
        this.ctx = null;
        this.ui = null;
        this.listEl = null;
        this.statusEl = null;

        this.animFrameId = null;
        this.resizeHandler = null;
    }

    colorFor(id) {
        return this.ID_COLORS[id] || '#ffffff';
    }

    nameFor(id) {
        return this.ID_NAMES[id] || id;
    }

    clampR(r) {
        r = parseInt(r) || 5;
        if (r < 1) r = 1;
        if (r > this.MAX_RADIUS) r = this.MAX_RADIUS;
        return r;
    }

    makeIdSet() {
        var s = {};
        for (var i = 0; i < this.ACTIVE_IDS.length; i++) s[this.ACTIVE_IDS[i]] = true;
        return s;
    }

    getO() {
        try {
            var app = window.app;
            var r = app._vnode.component.appContext.provides;
            var sym = Object.getOwnPropertySymbols(r).find(function(s){ return r[s] && r[s]._s; });
            if (!sym) return null;
            var o = r[sym]._s.get('gameState');
            if (!o || !o.gameWorld || !o.gameWorld.chunkManager || !o.gameWorld.player) return null;
            return o;
        } catch(e) { return null; }
    }

    findCamera(o) {
        if (this.camera) {
            try { if (this.camera.matrixWorldInverse) return this.camera; } catch(e){}
            this.camera = null;
        }
        try {
            var sys = o.gameWorld.systemsManager.activeSystems;
            for (var i = 0; i < sys.length; i++) {
                var s = sys[i]; if (!s) continue;
                var ks = Object.getOwnPropertyNames(s);
                for (var j = 0; j < ks.length; j++) {
                    try {
                        var v = s[ks[j]]; if (!v || typeof v !== 'object') continue;
                        if (v.isPerspectiveCamera || v.isCamera) { this.camera = v; return v; }
                        var ks2 = Object.getOwnPropertyNames(v);
                        for (var n = 0; n < ks2.length; n++) {
                            try {
                                var v2 = v[ks2[n]];
                                if (v2 && (v2.isPerspectiveCamera || v2.isCamera)) { this.camera = v2; return v2; }
                            } catch(e){}
                        }
                    } catch(e){}
                }
            }
        } catch(e){}
        return null;
    }

    worldToScreen(pp, rot, bx, by, bz) {
        if (this.camera && this.camera.projectionMatrix && this.camera.matrixWorldInverse) {
            try {
                var mv = this.camera.matrixWorldInverse.elements, p = this.camera.projectionMatrix.elements;
                var vx = mv[0]*bx + mv[4]*by + mv[8]*bz + mv[12], vy = mv[1]*bx + mv[5]*by + mv[9]*bz + mv[13];
                var vz = mv[2]*bx + mv[6]*by + mv[10]*bz + mv[14], vw = mv[3]*bx + mv[7]*by + mv[11]*bz + mv[15];
                var cx = p[0]*vx + p[4]*vy + p[8]*vz + p[12]*vw, cy = p[1]*vx + p[5]*vy + p[9]*vz + p[13]*vw;
                var cz = p[2]*vx + p[6]*vy + p[10]*vz + p[14]*vw, cw = p[3]*vx + p[7]*vy + p[11]*vz + p[15]*vw;
                if (cw <= 0 || cz/cw > 1) return null;
                return { x: ((cx/cw)*0.5 + 0.5)*this.cvs.width, y: (-(cy/cw)*0.5 + 0.5)*this.cvs.height };
            } catch(e) { this.camera = null; }
        }
        var dx = bx - pp[0], dy = by - pp[1] - 1.6, dz = bz - pp[2];
        var bYaw = Math.atan2(dx, dz) + Math.PI;
        var pYaw = ((rot.y % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI);
        var yd = bYaw - pYaw;
        while (yd > Math.PI) yd -= 2 * Math.PI;
        while (yd < -Math.PI) yd += 2 * Math.PI;
        if (Math.abs(yd) > Math.PI * 0.65) return null;
        var h = Math.sqrt(dx*dx + dz*dz), pd = Math.atan2(dy, h) - rot.x;
        var W = this.cvs.width, H = this.cvs.height, fvY = this.FOV_Y * Math.PI / 180, fvX = 2 * Math.atan(Math.tan(fvY/2) * W / H);
        return { x: W/2 + (yd/(fvX/2))*(W/2), y: H/2 - (pd/(fvY/2))*(H/2) };
    }

    startScan(o) {
        if (this.scanState) return;
        var R = this.clampR(this.SEARCH_RADIUS);
        var pos = Array.from(o.gameWorld.player.position);
        var sx = pos[0] >> 4, sy = pos[1] >> 4, sz = pos[2] >> 4;
        this.scanState = {
            cm: o.gameWorld.chunkManager,
            idSet: this.makeIdSet(),
            found: [], a: -R, l: -R, m: -R, R: R,
            cx: sx, cy: sy, cz: sz,
            pp: pos, total: Math.pow(2 * R + 1, 3), done: 0
        };
    }

    forceScan() {
        this.scanState = null; this.targetBlocks = []; this.allBlocks = [];
        var o = this.getO(); if (o) this.startScan(o);
    }

    tickScan() {
        if (!this.scanState) return;
        var st = this.scanState, R = st.R, steps = 0;
        while (steps < this.STEPS_FRAME) {
            var cx = st.cx + st.a, cy = st.cy + st.l, cz = st.cz + st.m;
            try {
                var arr = st.cm.getChunkArray(cx, cy, cz);
                if (arr) {
                    for (var g = 0; g < arr.length; g++) {
                        var bid = arr[g];
                        if (!st.idSet[bid]) continue;
                        var bx = (cx << 4) + (g & 15), by = (cy << 4) + ((g >> 4) & 15), bz = (cz << 4) + (g >> 8);
                        try { if (st.cm.getBlock(bx, by, bz) === bid) st.found.push({ bx: bx, by: by, bz: bz, id: bid }); } catch(e){}
                    }
                }
            } catch(e){}
            st.done++; st.m++;
            if (st.m > R) { st.m = -R; st.l++; }
            if (st.l > R) { st.l = -R; st.a++; }
            if (st.a > R) {
                this.allBlocks = st.found;
                var pp = st.pp; this.scanState = null;

                this.targetBlocks = this.allBlocks
                    .map(b => ({ b: b, d: Math.hypot(b.bx - pp[0], b.by - pp[1], b.bz - pp[2]) }))
                    .sort((a, z) => a.d - z.d)
                    .slice(0, this.BATCH_SIZE).map(x => x.b);
                return;
            }
            steps++;
        }
        if (this.statusEl) {
            var pct = Math.round(st.done / st.total * 100);
            this.statusEl.textContent = 'Escaneando... ' + pct + '%';
        }
    }

    blockExists(o, b) {
        try { return o.gameWorld.chunkManager.getBlock(b.bx, b.by, b.bz) === b.id; } catch(e) { return false; }
    }

    renderLoop() {
        if (!this.isEnabled) return;

        this.ctx.clearRect(0, 0, this.cvs.width, this.cvs.height);
        this.tickScan();
        var o = this.getO();

        if (o) {
            if (!this.camera) this.findCamera(o);
            if (this.camera) { try { this.camera.updateMatrixWorld(true); } catch(e) { this.camera = null; } }

            this.checkTick++;
            if (this.checkTick >= 45) {
                this.checkTick = 0;
                if (!this.scanState) {
                    var alive = this.targetBlocks.filter(b => this.blockExists(o, b));
                    if (alive.length < this.targetBlocks.length) this.startScan(o);
                }
            }

            if (this.espOn && this.targetBlocks.length) {
                var pp = Array.from(o.gameWorld.player.position);
                var rot = o.gameWorld.player.rotation;
                for (var i = 0; i < this.targetBlocks.length; i++) {
                    var b = this.targetBlocks[i];
                    var sc = this.worldToScreen(pp, rot, b.bx + 0.5, b.by + 0.5, b.bz + 0.5);
                    if (!sc || sc.x < -80 || sc.x > this.cvs.width + 80 || sc.y < -80 || sc.y > this.cvs.height + 80) continue;
                    var d = Math.hypot(b.bx - pp[0], b.by - pp[1], b.bz - pp[2]);
                    var sz = Math.max(8, Math.min(52, 400 / d)), hw = sz / 2;
                    var col = this.colorFor(b.id);

                    this.ctx.save();
