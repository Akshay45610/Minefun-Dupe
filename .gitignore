        };
        this.resizeHandler();
        window.addEventListener('resize', this.resizeHandler);
    }

    destroyCanvas() {
        if (this.cvs) {
            this.cvs.remove();
            this.cvs = null;
            this.ctx = null;
        }
        if (this.resizeHandler) {
            window.removeEventListener('resize', this.resizeHandler);
            this.resizeHandler = null;
        }
    }

    renderLoop() {
        if (!this.isEnabled) return;

        this.ctx.clearRect(0, 0, this.cvs.width, this.cvs.height);
        var o = this.getO();

        if (o) {
            if (!this.camera) this.findCamera(o);
            if (this.camera) {
                try { this.camera.updateMatrixWorld(true); } catch(e) { this.camera = null; }
            }

            let me = o.gameWorld.player;
            let players = o.gameWorld.server?.players || o.gameWorld.entities?.players;

            if (me && players && this.camera) {
                let defaultTracerColor = this.options["Tracer Color"] || "#ff0000";
                let cx = this.cvs.width / 2;
                let cy = this.cvs.height / 2;

                players.forEach(p => {
                    if (!p || p === me || (p.id !== undefined && me.id !== undefined && p.id === me.id) || !p.isAlive || !p.model) return;

                    let isBot = p.name === "Zombie" || p.name === "Skeleton" || !p.name;
                    if (isBot && !this.options["Target Bots/Mobs"]) return;
                    if (!isBot && !this.options["Target Players"]) return;

                    let tracerColor = this.getDynamicColor(p, defaultTracerColor);

                    let myPos = me.position;
                    let ePos = p.model.position || p.position;
                    let dist = Math.hypot(ePos.x - myPos[0] || ePos.x - myPos.x, ePos.y - myPos[1] || ePos.y - myPos.y, ePos.z - myPos[2] || ePos.z - myPos.z);

                    let feet2D = this.worldToScreen(ePos.x, ePos.y, ePos.z);
                    let head2D = this.worldToScreen(ePos.x, ePos.y + 1.8, ePos.z);

                    if (feet2D && head2D) {
                        this.ctx.beginPath();
