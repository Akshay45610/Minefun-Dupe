                    this.ctx.strokeStyle = 'rgba(0,0,0,0.9)'; this.ctx.lineWidth = 3;
                    this.ctx.strokeText(this.nameFor(b.id) + ' ' + d.toFixed(0) + 'm', sc.x, sc.y - hw - 3);
                    this.ctx.fillStyle = '#fff'; this.ctx.fillText(this.nameFor(b.id) + ' ' + d.toFixed(0) + 'm', sc.x, sc.y - hw - 3);
                    this.ctx.restore();
                }
            }

            if (!this.scanState) {
                var pp2 = Array.from(o.gameWorld.player.position);
                var camL = this.camera ? 'cam exacta' : 'angular FOV:' + this.FOV_Y;
                if (this.statusEl) this.statusEl.textContent = this.targetBlocks.length + '/' + this.BATCH_SIZE + ' activos | ' + this.allBlocks.length + ' total | ' + camL;
                if (this.listEl) {
                    this.listEl.textContent = this.targetBlocks.length === 0 ? 'none nearby' :
                        this.targetBlocks.map(b => ({ b: b, d: Math.hypot(b.bx - pp2[0], b.by - pp2[1], b.bz - pp2[2]) }))
                        .sort((a, z) => a.d - z.d)
                        .map(x => '[' + this.nameFor(x.b.id) + '] ' + x.b.bx + ',' + x.b.by + ',' + x.b.bz + '  ' + x.d.toFixed(1) + 'm')
