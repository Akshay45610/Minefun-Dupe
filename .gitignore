                return orig.apply(this, arguments);
            };
            if (!this.iwLogged) {
                this.iwLogged = true;
                this.log('movement system hooked - ice slipperiness removed');
            }
            return true;
        } catch (err) {
            return false;
        }
    }

    unwrap() {
        if (this.iwSys && this.iwOrigExec && this.iwSys.execute && this.iwSys.execute.name === 'iwWrappedExecute') {
            this.iwSys.execute = this.iwOrigExec;
        }
        this.iwSys = null;
        this.iwOrigExec = null;
        this.iwLogged = false;
    }

    tick() {
        if (!this.isEnabled) {
            this.onDisable();
            return;
        }
        const ctx = this.getCtx();
        if (ctx) {
            this.wrap(ctx.gw);
        }
        this.iwTimer = setTimeout(() => this.tick(), this.IW_SCAN_MS);
    }

    onEnable() {
        this.onDisable();
        this.log('enabled');
        this.tick();
    }

    onDisable() {
        if (this.iwTimer) {
            clearTimeout(this.iwTimer);
            this.iwTimer = 0;
        }
        this.unwrap();
        this.iwLogged = false;
        this.log('disabled');
    }

    onSettingsChange() {}
};
    var ModClutch = class extends a {
