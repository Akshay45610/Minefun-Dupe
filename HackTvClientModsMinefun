                        let showDist = this.options["Show Distance"];
                        let showHP = this.options["Show HP"];

                        if (showName || showDist || showHP) {
                            let pName = p.name || (isBot ? "Mob" : "Player");
                            let hpVal = this.getEntityHP(p);

                            let parts = [];
                            if (showName) parts.push(pName);
                            if (showHP && hpVal !== null) parts.push(hpVal + "HP");
                            if (showDist) parts.push("[" + Math.round(dist) + "m]");

                            let text = parts.join(" ");

