    makeDraggable(panelEl, headerEl) {
        let isDragging = false, startX, startY, initialLeft, initialTop;

        const onStart = (e) => {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
            isDragging = true;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            startX = clientX;
            startY = clientY;
            initialLeft = panelEl.offsetLeft;
            initialTop = panelEl.offsetTop;

            e.stopPropagation();
        };

        const onMove = (e) => {
            if (!isDragging) return;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;

            const newLeft = `${initialLeft + (clientX - startX)}px`;
            const newTop = `${initialTop + (clientY - startY)}px`;

            panelEl.style.left = newLeft;
            panelEl.style.top = newTop;

            if (!this.savedBounds) this.savedBounds = {};
            this.savedBounds.left = newLeft;
            this.savedBounds.top = newTop;

            if (e.cancelable) e.preventDefault();
            e.stopPropagation();
        };

        const onEnd = (e) => {
            if (isDragging) {
                isDragging = false;
                e.stopPropagation();
            }
        };

        headerEl.addEventListener("mousedown", onStart, { capture: true });
        headerEl.addEventListener("touchstart", onStart, { passive: false, capture: true });
        window.addEventListener("mousemove", onMove, { capture: true });
        window.addEventListener("touchmove", onMove, { passive: false, capture: true });
        window.addEventListener("mouseup", onEnd, { capture: true });
        window.addEventListener("touchend", onEnd, { capture: true });
    }

