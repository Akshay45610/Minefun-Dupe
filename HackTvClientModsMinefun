        }
    }

    onEnable() {
        this.onDisable();
        this.isEscaping = false;
        this.loop();
    }

    onDisable() {
        if (this.timer) {
            clearTimeout(this.timer);
            this.timer = null;
        }
    }

    onSettingsChange() {}
};
