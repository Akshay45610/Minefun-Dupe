    getTranslatedName(text) {
        let lang = this.options["Language"] || "English";
        if (this.translations[text]) {
            if (typeof this.translations[text] === "object") {
                if (this.translations[text].name && this.translations[text].name[lang]) {
                    return this.translations[text].name[lang];
                }
                if (this.translations[text][lang]) {
                    return this.translations[text][lang];
                }
            }
        }
        if (lang === "Tiếng Việt" && text.includes("patch:(")) {
            return text.replace(/patch:\(/g, "lỗi:(");
        }
        return text;
    }

    getTranslatedDesc(text) {
        let lang = this.options["Language"] || "English";
        if (this.translations[text] && this.translations[text].desc && this.translations[text].desc[lang]) {
