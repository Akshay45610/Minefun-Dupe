    formatKeyName(keyStr) {
        if (!keyStr) return "None";
        let str = keyStr.toString();

        const displayMap = {
            "Semicolon": ";",
            "Quote": "'",
            "Comma": ",",
            "Period": ".",
            "Slash": "/",
            "Backslash": "\\",
            "BracketLeft": "[",
            "BracketRight": "]",
            "Minus": "-",
            "Equal": "=",
            "Backquote": "`",
            "Space": "SPACE"
        };

        if (displayMap[str]) return displayMap[str];
        if (str.startsWith("Key") && str.length === 4) return str.replace("Key", "").toUpperCase();
        if (str.startsWith("Digit") && str.length === 6) return str.replace("Digit", "");
        if (str.length === 1) return str.toUpperCase();
        return str;
    }

    showModuleOptions(mod, x, y) {
        const oldPopup = document.querySelector(".v-option-popup");
        if (oldPopup) oldPopup.remove();

        const popup = document.createElement("div");
        popup.className = "v-option-popup";
        popup.style.left = `${Math.min(x, window.innerWidth - 240)}px`;
        popup.style.top = `${Math.min(y, window.innerHeight - 300)}px`;

        let currentKeyDisplay = this.formatKeyName(mod.keybind);

        let html = `<div class="v-option-title">${this.getTranslatedName(mod.name)} Options</div>`;

        html += `
            <div class="v-option-item">
                <span>Keybind:</span>
                <input type="text" class="v-option-input keybind-input" value="${currentKeyDisplay}" readonly style="width: 75px; cursor: pointer; text-transform: uppercase; font-weight: bold;" />
            </div>
        `;

        if (mod.options && typeof mod.options === "object") {
            Object.keys(mod.options).forEach(optKey => {
                let optVal = mod.options[optKey];
                let optType = typeof optVal;

                if (Array.isArray(optVal)) {
                    let selectedVal = mod.selectedOptions ? mod.selectedOptions[optKey] : optVal[0];
                    html += `
                        <div class="v-option-item">
                            <span>${optKey}:</span>
                            <select class="v-option-input mod-opt-select" data-key="${optKey}" style="width: 105px; background: #000; color: #ff0000; border: 1px solid #ff0000; cursor: pointer;">
                                ${optVal.map(opt => `<option value="${opt}" ${opt === selectedVal ? "selected" : ""}>${opt}</option>`).join("")}
                            </select>
                        </div>
                    `;
                } else if (optType === "boolean") {
                    html += `
                        <div class="v-option-item">
                            <span>${optKey}:</span>
                            <input type="checkbox" class="v-option-checkbox mod-opt" data-key="${optKey}" ${optVal ? "checked" : ""} />
                        </div>
                    `;
                } else if (optType === "number") {
                    html += `
                        <div class="v-option-item">
                            <span>${optKey}:</span>
                            <input type="number" class="v-option-input mod-opt" data-key="${optKey}" value="${optVal}" step="any" />
                        </div>
                    `;
                } else if (optType === "string") {
                    let isColor = optVal.startsWith("#") && (optVal.length === 4 || optVal.length === 7);
                    if (isColor) {
                        html += `
                            <div class="v-option-item">
                                <span>${optKey}:</span>
