    }

    getNearbyPlayer() {
        var o = this.getO();
        if (!o || !o.gameWorld.entityManager) return null;

        var myPos = Array.from(o.gameWorld.player.position);
        var entities = o.gameWorld.entityManager.entities || [];
        var maxDist = this.options["Escape Distance (1-8)"] || 3.5;
        var closestDist = maxDist;
        var targetPlayer = null;

        for (var i = 0; i < entities.length; i++) {
            var ent = entities[i];
            if (!ent || ent === o.gameWorld.player || !ent.position) continue;

            var ep = Array.from(ent.position);
            var dist = Math.hypot(ep[0] - myPos[0], ep[1] - myPos[1], ep[2] - myPos[2]);

            if (dist < closestDist) {
                closestDist = dist;
                targetPlayer = ent;
            }
        }
        return targetPlayer;
    }

    pressKey(code, duration, callback) {
        var keyChar = code === 'Space' ? ' ' : code.replace('Key', '').toLowerCase();
        var keyCodeNum = code === 'Space' ? 32 : code.charCodeAt(3);

        var downEvent = new KeyboardEvent('keydown', {
            code: code,
            key: keyChar,
            keyCode: keyCodeNum,
            which: keyCodeNum,
            bubbles: true,
            cancelable: true
        });

        var upEvent = new KeyboardEvent('keyup', {
            code: code,
            key: keyChar,
            keyCode: keyCodeNum,
            which: keyCodeNum,
            bubbles: true,
            cancelable: true
        });

        window.dispatchEvent(downEvent);
        document.dispatchEvent(downEvent);

        setTimeout(() => {
            window.dispatchEvent(upEvent);
            document.dispatchEvent(upEvent);
            if (callback) callback();
        }, duration);
    }

    escapeAction() {
        this.isEscaping = true;
        this.pressKey('KeyS', 200, () => {
            this.pressKey('Space', 100, () => {
                this.isEscaping = false;
            });
        });
    }

    loop() {
        if (!this.isEnabled) return;

        if (this.options["Auto Escape Hitbox"] && !this.isEscaping) {
            var nearby = this.getNearbyPlayer();
            if (nearby) {
                this.escapeAction();
                this.timer = setTimeout(() => this.loop(), 350);
                return;
            }
        }

        if (this.options["Bot Move"] && !this.isEscaping) {
            var randomCode = this.keys[Math.floor(Math.random() * this.keys.length)];
            var holdTime = 150 + Math.floor(Math.random() * 200);
            var restTime = 50 + Math.floor(Math.random() * 100);

