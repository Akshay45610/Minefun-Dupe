    createToggleButton() {
        if (document.getElementById("tvclient-toggle-btn")) return;
        this.toggleBtn = document.createElement("div");
        this.toggleBtn.id = "tvclient-toggle-btn";
        document.body.appendChild(this.toggleBtn);

        let isDragging = false;
        let hasDragged = false;
        let startX, startY, initialLeft, initialTop;

        const onStart = (e) => {
            isDragging = true;
            hasDragged = false;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            startX = clientX;
            startY = clientY;
            initialLeft = this.toggleBtn.offsetLeft;
            initialTop = this.toggleBtn.offsetTop;
        };

        const onMove = (e) => {
            if (!isDragging) return;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            const dx = clientX - startX;
            const dy = clientY - startY;

            if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
                hasDragged = true;
                if (e.cancelable) e.preventDefault();
            }

            this.toggleBtn.style.left = `${initialLeft + dx}px`;
            this.toggleBtn.style.top = `${initialTop + dy}px`;
        };

        const onEnd = () => {
            if (!isDragging) return;
            isDragging = false;
            if (!hasDragged) {
                this.toggle();
            }
        };

        this.toggleBtn.addEventListener("mousedown", onStart, { capture: true });
        this.toggleBtn.addEventListener("touchstart", onStart, { passive: false, capture: true });
        window.addEventListener("mousemove", onMove, { capture: true });
        window.addEventListener("touchmove", onMove, { passive: false, capture: true });
        window.addEventListener("mouseup", onEnd, { capture: true });
        window.addEventListener("touchend", onEnd, { capture: true });
    }

