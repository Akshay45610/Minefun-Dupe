                            this.ctx.font = "bold 11px system-ui, sans-serif";
                            let textWidth = this.ctx.measureText(text).width;
                            let padding = 4;
                            let tagWidth = textWidth + padding * 2;
                            let tagHeight = 16;
                            let tagX = feet2D.x - tagWidth / 2;
                            let tagY = boxY - 20;

                            this.ctx.fillStyle = "rgba(10, 8, 12, 0.85)";
                            this.ctx.fillRect(tagX, tagY, tagWidth, tagHeight);

                            this.ctx.strokeStyle = tracerColor;
                            this.ctx.lineWidth = 1;
                            this.ctx.strokeRect(tagX, tagY, tagWidth, tagHeight);

                            this.ctx.fillStyle = tracerColor;
                            this.ctx.textAlign = "center";
                            this.ctx.textBaseline = "middle";
                            this.ctx.fillText(text, feet2D.x, tagY + tagHeight / 2);
                            this.ctx.restore();
                        }
                    }
                });
            }
        } else {
            if (this.ctx && this.cvs) {
                this.ctx.clearRect(0, 0, this.cvs.width, this.cvs.height);
            }
            this.camera = null;
            this.lastWorldPlayer = null;
        }

        this.animFrameId = requestAnimationFrame(() => this.renderLoop());
    }

    onEnable() {
        this.camera = null;
